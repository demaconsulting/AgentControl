<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DemaConsulting.AgentControl.LauncherUI"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="720" d:DesignHeight="480"
        x:Class="DemaConsulting.AgentControl.LauncherUI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Name="MainWindowRoot"
        Title="AgentControl"
        Icon="/Assets/AppIcon.ico"
        Width="720" Height="480"
        MinWidth="480" MinHeight="320">
    <Window.Resources>
        <vm:FavoriteIconConverter x:Key="FavoriteIconConverter" />
        <vm:FavoriteColorConverter x:Key="FavoriteColorConverter" />
    </Window.Resources>
    <DockPanel Margin="12">

        <!-- Branding header: reuses the About window's logo treatment (white backing panel so
             the icon's black "D" stays visible against the dark theme) to give the window body
             its own identity beyond the native title bar. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Border Background="White" CornerRadius="6" Padding="3" Width="32" Height="32">
                <Image Source="avares://DemaConsulting.AgentControl/Assets/AppIcon.ico"
                        Width="26" Height="26" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="AgentControl" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="Distribute proprietary AI-agent configuration alongside public repositories"
                            FontSize="11" Opacity="0.65" />
            </StackPanel>
        </StackPanel>

        <!-- A thin accent-colored divider ties the header's brand identity to the accented
             Launch button and badges below, instead of the header floating disconnected from
             the rest of the UI. -->
        <Border DockPanel.Dock="Top"
                 Height="2"
                 Background="{DynamicResource SystemAccentColor}"
                 Margin="0,0,0,12" />

        <!-- Combined toolbar: filter box on the left, add-repo/settings/about icons on the right -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto,Auto,Auto"
              Margin="0,0,0,12">
            <!-- Filter box: substring-filters the recent-repos list by display name/path -->
            <TextBox Grid.Column="0"
                      Name="FilterTextBox"
                      AutomationProperties.AutomationId="FilterTextBox"
                      PlaceholderText="Filter repos..."
                      ToolTip.Tip="Filter the repo list below by name or path"
                      Text="{Binding FilterText, Mode=TwoWay}"
                      Margin="0,0,8,0" />
            <Button Grid.Column="1"
                     Name="AddRepoButton"
                     AutomationProperties.AutomationId="AddRepoButton"
                     Click="AddRepoButton_Click"
                     ToolTip.Tip="Add a repository"
                     Margin="0,0,8,0">
                <materialIcons:MaterialIcon Kind="FolderPlus" />
            </Button>
            <Button Grid.Column="2"
                     Name="OpenSettingsButton"
                     AutomationProperties.AutomationId="OpenSettingsButton"
                     Click="OpenSettingsButton_Click"
                     ToolTip.Tip="Settings"
                     Margin="0,0,8,0">
                <materialIcons:MaterialIcon Kind="Cog" />
            </Button>
            <Button Grid.Column="3"
                     Name="OpenAboutButton"
                     AutomationProperties.AutomationId="OpenAboutButton"
                     Click="OpenAboutButton_Click"
                     ToolTip.Tip="About AgentControl">
                <materialIcons:MaterialIcon Kind="Information" />
            </Button>
        </Grid>

        <!-- Recent-repos list, with an empty-state placeholder shown instead when there is
             nothing to display (no repos added yet, or the filter matches none). -->
        <Grid>
            <StackPanel Name="EmptyStatePanel"
                         AutomationProperties.AutomationId="EmptyStatePanel"
                         IsVisible="{Binding HasNoDisplayedRepos}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Spacing="8"
                         Opacity="0.6">
                <materialIcons:MaterialIcon Kind="FolderSearchOutline"
                                              Width="48" Height="48"
                                              HorizontalAlignment="Center" />
                <TextBlock Name="EmptyStateText"
                            AutomationProperties.AutomationId="EmptyStateText"
                            Text="{Binding EmptyStateMessage}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="320" />
            </StackPanel>

            <ListBox Name="RepoListBox"
                      AutomationProperties.AutomationId="RepoListBox"
                      IsVisible="{Binding !HasNoDisplayedRepos}"
                      ItemsSource="{Binding DisplayedRepoCards}">
            <ListBox.Styles>
                <!-- A subtle lift on hover (accented border plus a soft shadow nudged upward)
                     makes the (otherwise flat) card list feel interactive. -->
                <Style Selector="Border.RepoCard">
                    <Setter Property="BorderBrush" Value="Gray" />
                    <Setter Property="Background" Value="#0DFFFFFF" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                            <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="Border.RepoCard:pointerover">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
                    <Setter Property="Background" Value="#1AFFFFFF" />
                    <Setter Property="BoxShadow" Value="0 4 12 0 #40000000" />
                </Style>

                <!-- Chips: small rounded labels (icon plus short text) that each state one fact about
                     the repo. Neutral (default) chips state facts; amber chips ask for attention;
                     red chips report a problem. Mid-tone colors stay readable on the light and the
                     dark theme. A clickable chip is a flat button that wraps a chip. -->
                <Style Selector="Border.Chip">
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="7,1" />
                    <Setter Property="Margin" Value="0,0,6,4" />
                    <Setter Property="Background" Value="#14808080" />
                    <Setter Property="BorderBrush" Value="#55808080" />
                </Style>
                <Style Selector="Border.Chip.amber">
                    <Setter Property="Background" Value="#26D29922" />
                    <Setter Property="BorderBrush" Value="#99D29922" />
                    <Setter Property="TextElement.Foreground" Value="#BF8700" />
                </Style>
                <Style Selector="Border.Chip.red">
                    <Setter Property="Background" Value="#26E5534B" />
                    <Setter Property="BorderBrush" Value="#99E5534B" />
                    <Setter Property="TextElement.Foreground" Value="#E5534B" />
                </Style>
                <Style Selector="Border.Chip.grey">
                    <Setter Property="Background" Value="#0F808080" />
                    <Setter Property="BorderBrush" Value="#40808080" />
                    <Setter Property="Opacity" Value="0.85" />
                </Style>
                <Style Selector="Border.Chip.package">
                    <Setter Property="Background" Value="#1F3FA9F5" />
                    <Setter Property="BorderBrush" Value="#803FA9F5" />
                </Style>
                <Style Selector="Border.Chip TextBlock">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="Border.Chip materialIcons|MaterialIcon">
                    <Setter Property="Width" Value="13" />
                    <Setter Property="Height" Value="13" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="Button.chipButton">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
                <Style Selector="Button.chipButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="Button.chipButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="Button.chipButton:pointerover Border.Chip">
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="6,0" />
                </Style>
                <Style Selector="Button.chipButton:disabled">
                    <Setter Property="Opacity" Value="0.5" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RepoCardViewModel">
                    <Border Classes="RepoCard"
                             BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8"
                             AttachedToVisualTree="RepoCard_AttachedToVisualTree">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">

                            <!-- Title row: the repo's name on the left, its actions on the right -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                         VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Folder"
                                                              Width="16" Height="16"
                                                              Opacity="0.6"
                                                              VerticalAlignment="Center" />
                                <TextBlock Name="RepoNameText"
                                            AutomationProperties.AutomationId="RepoNameText"
                                            Text="{Binding RepoName}"
                                            ToolTip.Tip="{Binding RepoName}"
                                            FontWeight="Bold"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <ToggleButton Name="FavoriteToggleButton"
                                         AutomationProperties.AutomationId="FavoriteToggleButton"
                                         ToolTip.Tip="Favorite/pin this repo to the top of the list"
                                         IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                         Command="{Binding FavoriteToggleCommand}"
                                         VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                                                  Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteColorConverter}}" />
                                </ToggleButton>

                                <Button Name="LaunchButton"
                                         AutomationProperties.AutomationId="LaunchButton"
                                         Classes="accent"
                                         Command="{Binding LaunchCommand}"
                                         ToolTip.Tip="{Binding LaunchTooltip}"
                                         VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="Rocket" />
                                        <TextBlock Name="LaunchButtonText"
                                                    AutomationProperties.AutomationId="LaunchButtonText"
                                                    Text="{Binding LaunchButtonText}" />
                                    </StackPanel>
                                </Button>

                                <Button Name="PullButton"
                                         AutomationProperties.AutomationId="PullButton"
                                         Command="{Binding PullCommand}"
                                         ToolTip.Tip="{Binding PullTooltip}"
                                         ToolTip.ShowOnDisabled="True"
                                         VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="SourcePull" />
                                        <TextBlock Text="Git Pull" />
                                    </StackPanel>
                                </Button>

                                <Button Name="MoreActionsButton"
                                         AutomationProperties.AutomationId="MoreActionsButton"
                                         ToolTip.Tip="More actions"
                                         VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="DotsHorizontal" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Name="RefreshMenuItem"
                                                       AutomationProperties.AutomationId="RefreshMenuItem"
                                                       Header="Refresh"
                                                       ToolTip.Tip="Re-check this repo's branch, chips, and upgrade status"
                                                       Command="{Binding RefreshCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Refresh" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Name="SelectPackageMenuItem"
                                                       AutomationProperties.AutomationId="SelectPackageMenuItem"
                                                       Header="Select Package..."
                                                       ToolTip.Tip="Choose an initial agent package to pin to this repo"
                                                       IsVisible="{Binding IsPackageSelectionNeeded}"
                                                       Click="SelectPackageMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="PackageVariant" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Name="UpgradeMenuItem"
                                                       AutomationProperties.AutomationId="UpgradeMenuItem"
                                                       Header="Upgrade"
                                                       ToolTip.Tip="{Binding UpgradeTooltip}"
                                                       IsVisible="{Binding IsUpgradeAvailable}"
                                                       Command="{Binding UpgradeCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="ArrowUpBold" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Name="RemoveMenuItem"
                                                       AutomationProperties.AutomationId="RemoveMenuItem"
                                                       Header="Remove from list"
                                                       ToolTip.Tip="Remove this repo from AgentControl's recent-repos list (does not delete it from disk)"
                                                       Click="RemoveMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="TrashCan" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <!-- Chip row: what the repo has (agent package and where it came from, an
                                 available upgrade, the branch) and what needs attention (status
                                 chips). Every chip has a tooltip that explains it in full. -->
                            <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,4,0,0">

                                <!-- Agent package: robot icon, package name and version, and a small icon
                                     for the kind of source it came from (zip folder, NuGet folder, ...) -->
                                <Border Name="PackageChip"
                                         Classes="Chip package"
                                         IsVisible="{Binding HasPinnedPackage}"
                                         ToolTip.Tip="{Binding PackageChipTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="Robot" />
                                        <TextBlock Name="RepoPinnedVersionText"
                                                    AutomationProperties.AutomationId="RepoPinnedVersionText"
                                                    Text="{Binding PackageChipText}" />
                                        <materialIcons:MaterialIcon Name="PackageSourceIcon"
                                                                      AutomationProperties.AutomationId="PackageSourceIcon"
                                                                      Kind="{Binding PinnedSourceIcon}"
                                                                      Opacity="0.75" />
                                    </StackPanel>
                                </Border>

                                <!-- Upgrade: the version an upgrade would move the agent package to;
                                     clicking it starts the upgrade -->
                                <Button Name="UpgradeAvailableBadge"
                                         AutomationProperties.AutomationId="UpgradeAvailableBadge"
                                         AutomationProperties.Name="Agent package upgrade available"
                                         Classes="chipButton"
                                         IsVisible="{Binding IsUpgradeAvailable}"
                                         Command="{Binding UpgradeCommand}"
                                         ToolTip.Tip="{Binding UpgradeTooltip}">
                                    <Border Classes="Chip amber">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ArrowUpBold" />
                                            <TextBlock Name="UpgradeChipText"
                                                        AutomationProperties.AutomationId="UpgradeChipText"
                                                        Text="{Binding UpgradeChipText}" />
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <TextBlock Name="UpgradeCheckingText"
                                            AutomationProperties.AutomationId="UpgradeCheckingText"
                                            IsVisible="{Binding IsCheckingUpgrade}"
                                            Text="checking for updates..."
                                            FontSize="11" FontStyle="Italic" Opacity="0.6"
                                            VerticalAlignment="Center" Margin="0,0,6,4" />

                                <!-- No agent package pinned: clicking selects one -->
                                <Button Name="NoPackageChip"
                                         AutomationProperties.AutomationId="NoPackageChip"
                                         Classes="chipButton"
                                         IsVisible="{Binding ShowNoPackageChip}"
                                         Command="{Binding SelectPackageCommand}"
                                         ToolTip.Tip="No agent package is pinned for this repo, so no agent files are managed here. Click to select a package.">
                                    <Border Classes="Chip grey">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="RobotOutline" />
                                            <TextBlock Text="No agent package" />
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- Branch -->
                                <Border Name="BranchChip"
                                         Classes="Chip"
                                         IsVisible="{Binding HasBranch}"
                                         ToolTip.Tip="{Binding BranchTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="SourceBranch" />
                                        <TextBlock Name="CurrentBranchText"
                                                    AutomationProperties.AutomationId="CurrentBranchText"
                                                    Text="{Binding CurrentBranch}" />
                                    </StackPanel>
                                </Border>

                                <!-- Status chips: amber asks for attention, red reports a problem -->
                                <Border Name="DirtyWorkingTreeChip"
                                         Classes="Chip amber"
                                         IsVisible="{Binding IsWorkingTreeDirty}"
                                         ToolTip.Tip="{Binding PullTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="PencilCircleOutline" />
                                        <TextBlock Name="DirtyWorkingTreeBadge"
                                                    AutomationProperties.AutomationId="DirtyWorkingTreeBadge"
                                                    Text="Uncommitted changes" />
                                    </StackPanel>
                                </Border>
                                <Border Name="CommittedAgentFilesChip"
                                         Classes="Chip amber"
                                         IsVisible="{Binding HasCommittedAgentFiles}"
                                         ToolTip.Tip="This repo has committed agent files (.github/agents, .github/standards, .github/templates, or .github/skills) tracked at HEAD, so AgentControl does not manage them.">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="AlertOutline" />
                                        <TextBlock Name="CommittedAgentFilesBadge"
                                                    AutomationProperties.AutomationId="CommittedAgentFilesBadge"
                                                    Text="Committed agent files" />
                                    </StackPanel>
                                </Border>
                                <Border Name="MissingRepoChip"
                                         Classes="Chip red"
                                         IsVisible="{Binding IsMissing}"
                                         ToolTip.Tip="This repo's folder could not be found on disk.">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="FolderAlertOutline" />
                                        <TextBlock Name="MissingRepoBadge"
                                                    AutomationProperties.AutomationId="MissingRepoBadge"
                                                    Text="Folder missing" />
                                    </StackPanel>
                                </Border>
                                <Border Name="SourceProblemChip"
                                         Classes="Chip red"
                                         IsVisible="{Binding HasSourceProblem}"
                                         ToolTip.Tip="{Binding SourceProblem}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" />
                                        <TextBlock Name="SourceProblemBadge"
                                                    AutomationProperties.AutomationId="SourceProblemBadge"
                                                    Text="Package source problem" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Name="RepoPathText"
                                        AutomationProperties.AutomationId="RepoPathText"
                                        Text="{Binding RepoPath}"
                                        ToolTip.Tip="{Binding RepoPath}"
                                        TextTrimming="CharacterEllipsis"
                                        FontSize="11" Opacity="0.55" />

                            <!-- Progress of a running package operation, with a cancel button when the
                                 operation can be stopped -->
                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                   ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                   IsVisible="{Binding IsBusy}" Margin="0,4,0,0">
                                <TextBlock Name="BusyMessageText"
                                            AutomationProperties.AutomationId="BusyMessageText"
                                            Grid.Column="0"
                                            Text="{Binding BusyMessage}"
                                            FontSize="11" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1"
                                              Name="BusyProgress"
                                              AutomationProperties.AutomationId="BusyProgress"
                                              IsIndeterminate="True" Height="4"
                                              VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                         Name="CancelOperationButton"
                                         AutomationProperties.AutomationId="CancelOperationButton"
                                         Command="{Binding CancelOperationCommand}"
                                         IsVisible="{Binding CanCancelOperation}"
                                         ToolTip.Tip="Cancel the running operation"
                                         Padding="8,1" FontSize="11">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <materialIcons:MaterialIcon Kind="Cancel" Width="12" Height="12" />
                                        <TextBlock Text="Cancel" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
