<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DemaConsulting.AgentControl.LauncherUI"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="720" d:DesignHeight="480"
        x:Class="DemaConsulting.AgentControl.LauncherUI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Name="MainWindowRoot"
        Title="AgentControl"
        Icon="/Assets/AppIcon.ico"
        Width="720" Height="480"
        MinWidth="560" MinHeight="320">
    <Window.Resources>
        <vm:FavoriteIconConverter x:Key="FavoriteIconConverter" />
    </Window.Resources>
    <DockPanel>

        <!-- One compact app bar instead of a branded header plus a separate toolbar: the logo
             (the window title and the About box carry the name), the filter box stretching in
             the middle and the add-repo/settings/about icon buttons on the right. It sits on
             its own theme-aware surface with a thin separator below, inside the normal OS frame.
             The filter box is the first focus stop; it is the part that shrinks at narrow widths,
             so the buttons never clip. -->
        <Border DockPanel.Dock="Top"
                Name="AppBar"
                Background="{DynamicResource AppBarBackground}"
                BorderBrush="{DynamicResource SurfaceDivider}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <!-- The logo reuses the About window's treatment (white backing panel so the icon's
                 black "D" stays visible against the dark theme); it is not a control, only a
                 named picture with a tooltip. -->
            <Border Grid.Column="0"
                    Name="AppLogo"
                    AutomationProperties.AutomationId="AppLogo"
                    AutomationProperties.AccessibilityView="Content"
                    AutomationProperties.Name="AgentControl"
                    ToolTip.Tip="AgentControl"
                    Focusable="False"
                    Background="{DynamicResource LogoBackingBackground}"
                    CornerRadius="5" Padding="2" Width="28" Height="28"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">
                <Image Source="avares://DemaConsulting.AgentControl/Assets/AppIcon.ico"
                       AutomationProperties.AccessibilityView="Raw"
                       Width="24" Height="24" />
            </Border>
            <!-- Filter box: substring-filters the recent-repos list by display name/path -->
            <TextBox Grid.Column="1"
                      Name="FilterTextBox"
                      AutomationProperties.AutomationId="FilterTextBox"
                      PlaceholderText="Filter repos..."
                      ToolTip.Tip="Filter the repo list below by name or path"
                      Text="{Binding FilterText, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0" />
            <Button Grid.Column="2"
                     Name="AddRepoButton"
                     AutomationProperties.AutomationId="AddRepoButton"
                     AutomationProperties.Name="Add a repository"
                     Click="AddRepoButton_Click"
                     ToolTip.Tip="Add a repository"
                     Margin="0,0,8,0">
                <materialIcons:MaterialIcon Kind="FolderPlus" />
            </Button>
            <Button Grid.Column="3"
                     Name="OpenSettingsButton"
                     AutomationProperties.AutomationId="OpenSettingsButton"
                     AutomationProperties.Name="Settings"
                     Click="OpenSettingsButton_Click"
                     ToolTip.Tip="Settings"
                     Margin="0,0,8,0">
                <materialIcons:MaterialIcon Kind="Cog" />
            </Button>
            <Button Grid.Column="4"
                     Name="OpenAboutButton"
                     AutomationProperties.AutomationId="OpenAboutButton"
                     AutomationProperties.Name="About AgentControl"
                     Click="OpenAboutButton_Click"
                     ToolTip.Tip="About AgentControl">
                <materialIcons:MaterialIcon Kind="Information" />
            </Button>
        </Grid>
        </Border>

        <!-- Recent-repos list, with an empty-state placeholder shown instead when there is
             nothing to display (no repos added yet, or the filter matches none). -->
        <Grid Margin="12,8,12,12">
            <!-- Empty state: an intentional, card-like placeholder (icon tile, then the message)
                 instead of loose text floating on the page -->
            <Border Name="EmptyStatePanel"
                     AutomationProperties.AutomationId="EmptyStatePanel"
                     Classes="EmptyState"
                     IsVisible="{Binding HasNoDisplayedRepos}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <Border Classes="EmptyStateTile" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="FolderSearchOutline"
                                                      Width="34" Height="34"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Name="EmptyStateText"
                                AutomationProperties.AutomationId="EmptyStateText"
                                Text="{Binding EmptyStateMessage}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                FontSize="14"
                                MaxWidth="420" />
                </StackPanel>
            </Border>

            <!-- The shared card, chip, button and avatar styles live in RepoCardStyles.axaml (included
                 by App.axaml), with every color in its Light/Dark theme dictionaries. -->
            <ListBox Name="RepoListBox"
                      AutomationProperties.AutomationId="RepoListBox"
                      Classes="repoList"
                      Margin="-8,0,-8,0"
                      IsVisible="{Binding !HasNoDisplayedRepos}"
                      ItemsSource="{Binding DisplayedItems}">
            <!-- The list holds two kinds of rows: a section header (when repos are grouped) and a
                 repo card. Each has its own template, chosen by the row's type. -->
            <ListBox.DataTemplates>
                <DataTemplate DataType="vm:RepoGroupHeaderViewModel" x:DataType="vm:RepoGroupHeaderViewModel">
                    <!-- Section header: one flat button (chevron, icon, name, count) collapses or
                         expands the section; a user's own group also has a "..." menu to rename
                         or remove it. The accessible name says the section, its count and its state. -->
                    <Grid Name="GroupHeader" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                 Name="GroupHeaderToggleButton"
                                 AutomationProperties.AutomationId="GroupHeaderToggleButton"
                                 AutomationProperties.Name="{Binding AccessibleName}"
                                 Classes="groupToggle"
                                 HorizontalAlignment="Left"
                                 Command="{Binding ToggleCommand}"
                                 ToolTip.Tip="{Binding ToggleTooltip}"
                                 ToolTip.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Classes="chevron" Kind="ChevronDown" Width="18" Height="18"
                                                              IsVisible="{Binding IsExpanded}" />
                                <materialIcons:MaterialIcon Classes="chevron" Kind="ChevronRight" Width="18" Height="18"
                                                              IsVisible="{Binding IsCollapsed}" />
                                <materialIcons:MaterialIcon Kind="Star" Width="16" Height="16"
                                                              Foreground="{DynamicResource FavoriteStarForeground}"
                                                              IsVisible="{Binding IsFavoritesSection}" />
                                <materialIcons:MaterialIcon Kind="Folder" Width="16" Height="16"
                                                              IsVisible="{Binding IsUserGroup}" />
                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                                              IsVisible="{Binding IsUngroupedSection}" />
                                <TextBlock Name="GroupHeaderNameText"
                                            AutomationProperties.AutomationId="GroupHeaderNameText"
                                            Text="{Binding Name}"
                                            FontWeight="SemiBold" FontSize="14"
                                            MaxWidth="360" TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                <Border Classes="Chip grey" ToolTip.Tip="{Binding CountTooltip}">
                                    <TextBlock Name="GroupHeaderCountText"
                                                AutomationProperties.AutomationId="GroupHeaderCountText"
                                                Text="{Binding Count}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                 Name="GroupHeaderMenuButton"
                                 AutomationProperties.AutomationId="GroupHeaderMenuButton"
                                 AutomationProperties.Name="{Binding Name, StringFormat='Actions for group {0}'}"
                                 Classes="iconGhost"
                                 Margin="0,0,15,0"
                                 IsVisible="{Binding IsUserGroup}"
                                 ToolTip.Tip="Rename or remove this group">
                            <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Name="RenameGroupMenuItem"
                                               AutomationProperties.AutomationId="RenameGroupMenuItem"
                                               Header="Rename group..."
                                               ToolTip.Tip="Give this group a different name"
                                               Command="{Binding RenameCommand}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="Pencil" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Name="RemoveGroupMenuItem"
                                               AutomationProperties.AutomationId="RemoveGroupMenuItem"
                                               Header="Remove group"
                                               ToolTip.Tip="Remove this group; its repos stay in the list, ungrouped"
                                               Command="{Binding RemoveGroupCommand}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="FolderRemove" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:RepoCardViewModel" x:DataType="vm:RepoCardViewModel">
                    <Border Classes="RepoCard"
                             AttachedToVisualTree="RepoCard_AttachedToVisualTree">
                        <!-- Accent bar (overall status) | card body -->
                        <Grid ColumnDefinitions="Auto,*">
                            <!-- Status accent: green = up to date, amber = upgrade available, red =
                                 a problem, grey = no package yet. Color is never the only carrier:
                                 the bar has an accessible name and tooltip, and the chips say the
                                 same in words. -->
                            <Border Name="RepoStatusAccent"
                                     AutomationProperties.AutomationId="RepoStatusAccent"
                                     AutomationProperties.AccessibilityView="Content"
                                     AutomationProperties.Name="{Binding StatusText}"
                                     Classes="StatusAccent"
                                     Classes.statusUpToDate="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:RepoCardStatus.UpToDate}}"
                                     Classes.statusUpgrade="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:RepoCardStatus.UpgradeAvailable}}"
                                     Classes.statusProblem="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:RepoCardStatus.Problem}}"
                                     Classes.statusTagMoved="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:RepoCardStatus.TagMoved}}"
                                     ToolTip.Tip="{Binding StatusTooltip}" />

                            <!-- Card body. Row 0 is the identity line - favorite star, then the repo
                                 name right beside it - with the actions (Launch, more) on its right.
                                 Below it sits the avatar tile, left-aligned under the star, beside
                                 the chips and the path. -->
                            <Grid Grid.Column="1" Margin="14,12,14,14"
                                   ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                   RowDefinitions="Auto,Auto">

                            <Grid Grid.Row="0" Grid.Column="0"
                                   ColumnDefinitions="Auto,*" ColumnSpacing="1"
                                   VerticalAlignment="Center">
                                <!-- Favorite star: a borderless ghost toggle, gold and filled when
                                     favorited, an outline otherwise. Its IsChecked binding is the only
                                     owner of the state (no Command: a command that also toggled would
                                     flip it a second time on every click). It is 28px (the glyph is 18px),
                                     and the negative left margin puts the glyph itself - not the
                                     button's invisible edge - on the card's content edge, in line
                                     with the avatar tile below. -->
                                <ToggleButton Grid.Column="0"
                                         Name="FavoriteToggleButton"
                                         AutomationProperties.AutomationId="FavoriteToggleButton"
                                         Classes="iconGhost"
                                         Width="28" Height="28" MinWidth="28" MinHeight="28"
                                         Margin="-7,0,0,0"
                                         AutomationProperties.Name="Favorite"
                                         ToolTip.Tip="Favorite/pin this repo to the top of the list"
                                         IsChecked="{Binding IsFavorite, Mode=TwoWay}">
                                    <materialIcons:MaterialIcon Width="18" Height="18"
                                                                  Kind="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}" />
                                </ToggleButton>

                                <!-- The repo's name, a small gap from the star -->
                                <TextBlock Grid.Column="1"
                                            Name="RepoNameText"
                                            Margin="-3,0,0,0"
                                            AutomationProperties.AutomationId="RepoNameText"
                                            Text="{Binding RepoName}"
                                            ToolTip.Tip="{Binding RepoName}"
                                            FontWeight="Bold" FontSize="15"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                            </Grid>

                            <!-- Actions: only the repo's actions live on the right, level with the
                                 identity line, so the chips, status message and progress rows that
                                 come and go below never move them -->
                            <StackPanel Grid.Row="0" Grid.Column="1"
                                         Orientation="Horizontal" Spacing="8"
                                         VerticalAlignment="Center">
                                <Button Name="LaunchButton"
                                         AutomationProperties.AutomationId="LaunchButton"
                                         Classes="actionButton primary"
                                         Command="{Binding LaunchCommand}"
                                         ToolTip.Tip="{Binding LaunchTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="Rocket" Width="16" Height="16" />
                                        <TextBlock Name="LaunchButtonText"
                                                    AutomationProperties.AutomationId="LaunchButtonText"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding LaunchButtonText}" />
                                    </StackPanel>
                                </Button>

                                <Button Name="MoreActionsButton"
                                         AutomationProperties.AutomationId="MoreActionsButton"
                                         AutomationProperties.Name="More actions"
                                         Classes="iconGhost"
                                         ToolTip.Tip="More actions">
                                    <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" />
                                    <Button.Flyout>
                                        <!-- Grouped menu: Repository (Git Pull, Refresh), Agent files (Select
                                             Package or Upgrade, whichever applies), Organize (Move to group,
                                             Card color), then Remove. The group
                                             headers are disabled items (not interactive, skipped by the
                                             keyboard) styled as small captions. -->
                                        <MenuFlyout Opening="CardMenu_Opening">
                                            <MenuItem Classes="groupHeader" IsEnabled="False" Focusable="False"
                                                       Header="Repository" />
                                            <MenuItem Name="PullButton"
                                                       AutomationProperties.AutomationId="PullButton"
                                                       Header="Git Pull"
                                                       ToolTip.Tip="{Binding PullTooltip}"
                                                       ToolTip.ShowOnDisabled="True"
                                                       Command="{Binding PullCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="SourcePull" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Name="RefreshMenuItem"
                                                       AutomationProperties.AutomationId="RefreshMenuItem"
                                                       Header="{Binding RefreshMenuText}"
                                                       ToolTip.Tip="{Binding RefreshTooltip}"
                                                       Command="{Binding RefreshCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Refresh" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator IsVisible="{Binding HasAgentFileActions}" />
                                            <MenuItem Classes="groupHeader" IsEnabled="False" Focusable="False"
                                                       Header="Agent files"
                                                       IsVisible="{Binding HasAgentFileActions}" />
                                            <MenuItem Name="SelectPackageMenuItem"
                                                       AutomationProperties.AutomationId="SelectPackageMenuItem"
                                                       Header="Select Package..."
                                                       ToolTip.Tip="Choose an initial agent package to pin to this repo"
                                                       IsVisible="{Binding IsPackageSelectionNeeded}"
                                                       Click="SelectPackageMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="PackageVariant" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <!-- A pinned repo can choose another package or version, or accept content that
                                                 changed behind the version it already uses (the dialog opens on the current
                                                 choice) -->
                                            <MenuItem Name="ChangePackageMenuItem"
                                                       AutomationProperties.AutomationId="ChangePackageMenuItem"
                                                       Header="Change package..."
                                                       ToolTip.Tip="Choose another package or version for this repo, or choose the current version again to accept changed content"
                                                       IsVisible="{Binding HasPinnedPackage}"
                                                       Click="SelectPackageMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="SwapHorizontal" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Name="UpgradeMenuItem"
                                                       AutomationProperties.AutomationId="UpgradeMenuItem"
                                                       Header="{Binding UpgradeChipText, StringFormat='Upgrade to {0}'}"
                                                       ToolTip.Tip="{Binding UpgradeTooltip}"
                                                       IsVisible="{Binding IsUpgradeAvailable}"
                                                       Command="{Binding UpgradeCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="ArrowUpBold" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Classes="groupHeader" IsEnabled="False" Focusable="False"
                                                       Header="Organize" />
                                            <!-- The submenu's entries (the groups, New group, Remove from group)
                                                 are filled in when the menu opens: see CardMenu_Opening -->
                                            <MenuItem Name="MoveToGroupMenuItem"
                                                       AutomationProperties.AutomationId="MoveToGroupMenuItem"
                                                       Header="Move to group"
                                                       ToolTip.Tip="Put this repo in one of your groups, or start a new group (stored only in your AgentControl settings, never in the repository)">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="FolderMultipleOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Name="CardColorMenuItem"
                                                       AutomationProperties.AutomationId="CardColorMenuItem"
                                                       Header="Card color..."
                                                       ToolTip.Tip="Choose the color of this repo's tile (stored only in your AgentControl settings; the status bar keeps its colors)"
                                                       Click="CardColorMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Palette" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Name="RemoveMenuItem"
                                                       AutomationProperties.AutomationId="RemoveMenuItem"
                                                       Header="Remove from list"
                                                       ToolTip.Tip="Remove this repo from AgentControl's recent-repos list (does not delete it from disk)"
                                                       Click="RemoveMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="TrashCan" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>

                                    <!-- Card color palette: a small pop-up under the "..." button, opened by
                                         the menu's "Card color..." item (see CardColorMenuItem_Click). The
                                         swatches are the avatar palette in the current theme, "Automatic"
                                         goes back to the color derived from the repo path. -->
                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel Name="CardColorPalette"
                                                         AutomationProperties.AutomationId="CardColorPalette"
                                                         AutomationProperties.AccessibilityView="Content"
                                                         AutomationProperties.Name="Card color palette"
                                                         Spacing="10">
                                                <TextBlock Name="CardColorHeadingText" Text="{Binding CardColorHeading}" FontWeight="SemiBold" />
                                                <UniformGrid Columns="5">
                                                    <Button Classes="swatch avatar0" Margin="3" Tag="Blue"
                                                             Classes.selected="{Binding CardColorName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Blue}"
                                                             AutomationProperties.AutomationId="CardColorSwatch_Blue"
                                                             AutomationProperties.Name="Blue"
                                                             ToolTip.Tip="Blue" Click="CardColorSwatch_Click">
                                                        <materialIcons:MaterialIcon Kind="Check" />
                                                    </Button>
                                                    <Button Classes="swatch avatar1" Margin="3" Tag="Violet"
                                                             Classes.selected="{Binding CardColorName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Violet}"
                                                             AutomationProperties.AutomationId="CardColorSwatch_Violet"
                                                             AutomationProperties.Name="Violet"
                                                             ToolTip.Tip="Violet" Click="CardColorSwatch_Click">
                                                        <materialIcons:MaterialIcon Kind="Check" />
                                                    </Button>
                                                    <Button Classes="swatch avatar2" Margin="3" Tag="Magenta"
                                                             Classes.selected="{Binding CardColorName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Magenta}"
                                                             AutomationProperties.AutomationId="CardColorSwatch_Magenta"
                                                             AutomationProperties.Name="Magenta"
                                                             ToolTip.Tip="Magenta" Click="CardColorSwatch_Click">
                                                        <materialIcons:MaterialIcon Kind="Check" />
                                                    </Button>
                                                    <Button Classes="swatch avatar3" Margin="3" Tag="Green"
                                                             Classes.selected="{Binding CardColorName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Green}"
                                                             AutomationProperties.AutomationId="CardColorSwatch_Green"
                                                             AutomationProperties.Name="Green"
                                                             ToolTip.Tip="Green" Click="CardColorSwatch_Click">
                                                        <materialIcons:MaterialIcon Kind="Check" />
                                                    </Button>
                                                    <Button Classes="swatch avatar4" Margin="3" Tag="Amber"
                                                             Classes.selected="{Binding CardColorName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Amber}"
                                                             AutomationProperties.AutomationId="CardColorSwatch_Amber"
                                                             AutomationProperties.Name="Amber"
                                                             ToolTip.Tip="Amber" Click="CardColorSwatch_Click">
                                                        <materialIcons:MaterialIcon Kind="Check" />
                                                    </Button>
                                                    <Button Classes="swatch avatar5" Margin="3" Tag="Teal"
                                                             Classes.selected="{Binding CardColorName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Teal}"
                                                             AutomationProperties.AutomationId="CardColorSwatch_Teal"
                                                             AutomationProperties.Name="Teal"
                                                             ToolTip.Tip="Teal" Click="CardColorSwatch_Click">
                                                        <materialIcons:MaterialIcon Kind="Check" />
                                                    </Button>
                                                    <Button Classes="swatch avatar6" Margin="3" Tag="Orange"
                                                             Classes.selected="{Binding CardColorName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Orange}"
                                                             AutomationProperties.AutomationId="CardColorSwatch_Orange"
                                                             AutomationProperties.Name="Orange"
                                                             ToolTip.Tip="Orange" Click="CardColorSwatch_Click">
                                                        <materialIcons:MaterialIcon Kind="Check" />
                                                    </Button>
                                                    <Button Classes="swatch avatar7" Margin="3" Tag="Indigo"
                                                             Classes.selected="{Binding CardColorName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Indigo}"
                                                             AutomationProperties.AutomationId="CardColorSwatch_Indigo"
                                                             AutomationProperties.Name="Indigo"
                                                             ToolTip.Tip="Indigo" Click="CardColorSwatch_Click">
                                                        <materialIcons:MaterialIcon Kind="Check" />
                                                    </Button>
                                                    <Button Classes="swatch avatar8" Margin="3" Tag="Red"
                                                             Classes.selected="{Binding CardColorName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Red}"
                                                             AutomationProperties.AutomationId="CardColorSwatch_Red"
                                                             AutomationProperties.Name="Red"
                                                             ToolTip.Tip="Red" Click="CardColorSwatch_Click">
                                                        <materialIcons:MaterialIcon Kind="Check" />
                                                    </Button>
                                                    <Button Classes="swatch avatar9" Margin="3" Tag="Lime"
                                                             Classes.selected="{Binding CardColorName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Lime}"
                                                             AutomationProperties.AutomationId="CardColorSwatch_Lime"
                                                             AutomationProperties.Name="Lime"
                                                             ToolTip.Tip="Lime" Click="CardColorSwatch_Click">
                                                        <materialIcons:MaterialIcon Kind="Check" />
                                                    </Button>
                                                </UniformGrid>
                                                <Button Name="CardColorAutomaticButton"
                                                         AutomationProperties.AutomationId="CardColorAutomaticButton"
                                                         Classes="actionButton secondary"
                                                         Tag=""
                                                         HorizontalAlignment="Stretch"
                                                         ToolTip.Tip="Use the color AgentControl derives from this repo's path"
                                                         Click="CardColorSwatch_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="AutoFix" Width="16" Height="16" />
                                                        <TextBlock Text="Automatic" VerticalAlignment="Center" />
                                                        <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16"
                                                                                      IsVisible="{Binding IsCardColorAutomatic}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                </Button>
                            </StackPanel>

                            <!-- Body: the avatar tile (left-aligned under the star, as tall as the chip
                                 row plus the path row) beside the chips, the path and, when present,
                                 the last action's message and the progress of a running operation -->
                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                   ColumnDefinitions="Auto,*" ColumnSpacing="12"
                                   RowDefinitions="Auto,Auto,Auto,Auto">

                            <!-- Avatar: the repo's own picture (root icon.png or logo.png) letterboxed on
                                 the tile, else its initials on the tile color (the color the user chose,
                                 else a stable per-repo color), else a folder glyph when the name has no
                                 letters or digits. The palette class (avatar0..avatar9) selects the
                                 theme-aware fill and letter colors; exactly one is on at a time. A chosen
                                 color shows as a ring around a picture (customColor). -->
                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                     Name="RepoAvatar"
                                     Classes="Avatar"
                                     Classes.hasImage="{Binding HasRepoImage}"
                                     Classes.customColor="{Binding HasCustomCardColor}"
                                     Classes.avatar0="{Binding AvatarStyleClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=avatar0}"
                                     Classes.avatar1="{Binding AvatarStyleClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=avatar1}"
                                     Classes.avatar2="{Binding AvatarStyleClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=avatar2}"
                                     Classes.avatar3="{Binding AvatarStyleClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=avatar3}"
                                     Classes.avatar4="{Binding AvatarStyleClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=avatar4}"
                                     Classes.avatar5="{Binding AvatarStyleClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=avatar5}"
                                     Classes.avatar6="{Binding AvatarStyleClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=avatar6}"
                                     Classes.avatar7="{Binding AvatarStyleClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=avatar7}"
                                     Classes.avatar8="{Binding AvatarStyleClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=avatar8}"
                                     Classes.avatar9="{Binding AvatarStyleClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=avatar9}"
                                     VerticalAlignment="Top" HorizontalAlignment="Left"
                                     ClipToBounds="True">
                                <Panel>
                                    <Image Name="RepoAvatarImage"
                                            AutomationProperties.AutomationId="RepoAvatarImage"
                                            Source="{Binding RepoImage}"
                                            IsVisible="{Binding HasRepoImage}"
                                            Stretch="Uniform" Margin="3" />
                                    <TextBlock Name="RepoAvatarText"
                                                AutomationProperties.AutomationId="RepoAvatarText"
                                                Text="{Binding AvatarInitials}"
                                                IsVisible="{Binding ShowAvatarInitials}"
                                                FontSize="16" FontWeight="Bold"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <materialIcons:MaterialIcon Kind="Folder"
                                                                  IsVisible="{Binding ShowAvatarFolderGlyph}"
                                                                  Width="22" Height="22"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                </Panel>
                            </Border>

                            <!-- Chip row: what the repo has (agent package and where it came from, an
                                 available upgrade, the branch) and what needs attention (status
                                 chips). Every chip has a tooltip that explains it in full. -->
                            <WrapPanel Grid.Row="0" Grid.Column="1"
                                        Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"
                                        MinHeight="22">

                                <!-- Agent package: robot icon, package name and version, then where it came
                                     from: the source kind's icon (zip folder, NuGet folder, server) and the
                                     source's alias as muted text, so the source is recognizable at a glance -->
                                <Border Name="PackageChip"
                                         Classes="Chip package"
                                         IsVisible="{Binding HasPinnedPackage}"
                                         ToolTip.Tip="{Binding PackageChipTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="Robot" />
                                        <TextBlock Name="RepoPinnedVersionText"
                                                    AutomationProperties.AutomationId="RepoPinnedVersionText"
                                                    Text="{Binding PackageChipText}" />
                                        <!-- Healthy-card cue: a small check mark inside the chip (no extra
                                             chip or row) while the pinned package is the newest one. Its own
                                             tooltip and accessible name say it in words. -->
                                        <materialIcons:MaterialIcon Name="UpToDateCue"
                                                                      AutomationProperties.AutomationId="UpToDateCue"
                                                                      AutomationProperties.AccessibilityView="Content"
                                                                      AutomationProperties.Name="Agent files are up to date"
                                                                      Kind="CheckCircle"
                                                                      Foreground="{DynamicResource SuccessForeground}"
                                                                      IsVisible="{Binding ShowUpToDateCue}"
                                                                      ToolTip.Tip="Agent files are up to date" />
                                        <materialIcons:MaterialIcon Name="PackageSourceIcon"
                                                                      AutomationProperties.AutomationId="PackageSourceIcon"
                                                                      Kind="{Binding PinnedSourceIcon}"
                                                                      Width="16" Height="16"
                                                                      Margin="4,0,0,0"
                                                                      Opacity="0.9" />
                                        <TextBlock Name="PackageSourceAliasText"
                                                    AutomationProperties.AutomationId="PackageSourceAliasText"
                                                    Text="{Binding PinnedSourceLabel}"
                                                    Opacity="0.7"
                                                    MaxWidth="120" TextTrimming="CharacterEllipsis" />
                                        <materialIcons:MaterialIcon Name="PackageSignatureIcon"
                                                                      AutomationProperties.AutomationId="PackageSignatureIcon"
                                                                      AutomationProperties.AccessibilityView="Content"
                                                                      AutomationProperties.Name="{Binding SignatureTooltip}"
                                                                      Kind="ShieldCheck"
                                                                      Width="14" Height="14"
                                                                      IsVisible="{Binding RequiresSignature}"
                                                                      ToolTip.Tip="{Binding SignatureTooltip}"
                                                                      Opacity="0.9" />
                                    </StackPanel>
                                </Border>

                                <!-- Upgrade: the version an upgrade would move the agent package to;
                                     clicking it starts the upgrade -->
                                <Button Name="UpgradeAvailableBadge"
                                         AutomationProperties.AutomationId="UpgradeAvailableBadge"
                                         AutomationProperties.Name="Agent package upgrade available"
                                         Classes="chipButton"
                                         IsVisible="{Binding IsUpgradeAvailable}"
                                         Command="{Binding UpgradeCommand}"
                                         ToolTip.Tip="{Binding UpgradeTooltip}">
                                    <Border Classes="Chip amber">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ArrowUpBold" />
                                            <TextBlock Text="Upgrade to" />
                                            <TextBlock Name="UpgradeChipText"
                                                        AutomationProperties.AutomationId="UpgradeChipText"
                                                        Text="{Binding UpgradeChipText}" />
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- A Git tag that now names another commit than the one the repo's files
                                     came from: amber, explains itself in the tooltip, and a click only opens
                                     "Change package..." - nothing is ever applied by itself -->
                                <Button Name="TagMovedChip"
                                         AutomationProperties.AutomationId="TagMovedChip"
                                         AutomationProperties.Name="Tag moved"
                                         Classes="chipButton"
                                         IsVisible="{Binding IsPinnedTagMoved}"
                                         Command="{Binding SelectPackageCommand}"
                                         ToolTip.Tip="{Binding PinnedTagMovedTooltip}">
                                    <Border Classes="Chip amber">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="TagArrowRightOutline" />
                                            <TextBlock Name="TagMovedBadge"
                                                        AutomationProperties.AutomationId="TagMovedBadge"
                                                        Text="Tag moved" />
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <TextBlock Name="UpgradeCheckingText"
                                            AutomationProperties.AutomationId="UpgradeCheckingText"
                                            IsVisible="{Binding IsCheckingUpgrade}"
                                            Text="checking for updates..."
                                            FontSize="12" FontStyle="Italic" Opacity="0.7"
                                            VerticalAlignment="Center" />

                                <!-- No agent package pinned: clicking selects one -->
                                <Button Name="NoPackageChip"
                                         AutomationProperties.AutomationId="NoPackageChip"
                                         Classes="chipButton"
                                         IsVisible="{Binding ShowNoPackageChip}"
                                         Command="{Binding SelectPackageCommand}"
                                         ToolTip.Tip="No agent package is pinned for this repo, so no agent files are managed here. Click to select a package.">
                                    <Border Classes="Chip grey">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="RobotOutline" />
                                            <TextBlock Text="No agent package" />
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- Branch -->
                                <Border Name="BranchChip"
                                         Classes="Chip"
                                         IsVisible="{Binding HasBranch}"
                                         ToolTip.Tip="{Binding BranchTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="SourceBranch" />
                                        <TextBlock Name="CurrentBranchText"
                                                    AutomationProperties.AutomationId="CurrentBranchText"
                                                    Text="{Binding CurrentBranch}" />
                                    </StackPanel>
                                </Border>

                                <!-- The user's group: shown on favorites only, because a favorite is listed
                                     under Favorites instead of under its group -->
                                <Border Name="GroupChip"
                                         Classes="Chip"
                                         IsVisible="{Binding ShowGroupChip}"
                                         ToolTip.Tip="{Binding GroupName, StringFormat='In the group {0}. Favorites are listed under Favorites; unfavorite this repo to list it under its group.'}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="FolderOutline" />
                                        <TextBlock Name="GroupChipText"
                                                    AutomationProperties.AutomationId="GroupChipText"
                                                    Text="{Binding GroupName}"
                                                    MaxWidth="140" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <!-- Status chips: amber asks for attention, red reports a problem -->
                                <Border Name="DirtyWorkingTreeChip"
                                         Classes="Chip amber"
                                         IsVisible="{Binding IsWorkingTreeDirty}"
                                         ToolTip.Tip="{Binding PullTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="FileEditOutline" />
                                        <TextBlock Name="DirtyWorkingTreeBadge"
                                                    AutomationProperties.AutomationId="DirtyWorkingTreeBadge"
                                                    Text="Uncommitted changes" />
                                    </StackPanel>
                                </Border>
                                <Border Name="CommittedAgentFilesChip"
                                         Classes="Chip amber"
                                         IsVisible="{Binding HasCommittedAgentFiles}"
                                         ToolTip.Tip="This repo has committed agent files (.github/agents, .github/standards, .github/templates, or .github/skills) tracked at HEAD, so AgentControl does not manage them.">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="AlertOutline" />
                                        <TextBlock Name="CommittedAgentFilesBadge"
                                                    AutomationProperties.AutomationId="CommittedAgentFilesBadge"
                                                    Text="Committed agent files" />
                                    </StackPanel>
                                </Border>
                                <Border Name="MissingRepoChip"
                                         Classes="Chip red"
                                         IsVisible="{Binding IsMissing}"
                                         ToolTip.Tip="This repo's folder could not be found on disk. Choose Check again in the card menu once it is back.">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="FolderAlertOutline" />
                                        <TextBlock Name="MissingRepoBadge"
                                                    AutomationProperties.AutomationId="MissingRepoBadge"
                                                    Text="Folder missing" />
                                    </StackPanel>
                                </Border>
                                <Border Name="SourceProblemChip"
                                         Classes="Chip red"
                                         IsVisible="{Binding HasSourceProblem}"
                                         ToolTip.Tip="{Binding SourceProblem}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" />
                                        <TextBlock Name="SourceProblemBadge"
                                                    AutomationProperties.AutomationId="SourceProblemBadge"
                                                    Text="{Binding SourceProblemChipText}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- The repo's path, shortened to fit: the folder part gives way first (end
                                 ellipsis), the last segment - the repo's folder name, which tells similar
                                 repos apart - is shown whole while it fits and otherwise gets a middle
                                 ellipsis that keeps its start and its end. The control carries the full path
                                 as its accessible name and tooltip; the text it draws is hidden from
                                 automation so the path is not read twice. -->
                            <vm:PathEllipsisText Grid.Row="1" Grid.Column="1"
                                   Name="RepoPathText"
                                   AutomationProperties.AutomationId="RepoPathText"
                                   AutomationProperties.AccessibilityView="Content"
                                   AutomationProperties.Name="{Binding RepoPath}"
                                   ToolTip.Tip="{Binding RepoPath}"
                                   ParentText="{Binding RepoPathParent}"
                                   LeafText="{Binding RepoPathLeaf}"
                                   HorizontalAlignment="Left"
                                   TextElement.FontSize="12"
                                   Opacity="0.65" Margin="0,6,0,0" />

                            <!-- The outcome of the last action (for example a failed Git Pull and
                                 git's reason), so a button that was clicked always shows what happened -->
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                        Name="RepoStatusMessageText"
                                        AutomationProperties.AutomationId="RepoStatusMessageText"
                                        IsVisible="{Binding HasStatusMessage}"
                                        Text="{Binding StatusMessage}"
                                        ToolTip.Tip="{Binding StatusMessage}"
                                        TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                                        FontSize="12" Opacity="0.9" Margin="0,8,0,0" />

                            <!-- Progress of a running package operation, with a cancel button when the
                                 operation can be stopped -->
                            <Grid Grid.Row="3" Grid.Column="1"
                                   ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                   IsVisible="{Binding IsBusy}" Margin="0,8,0,0">
                                <TextBlock Name="BusyMessageText"
                                            AutomationProperties.AutomationId="BusyMessageText"
                                            Grid.Column="0"
                                            Text="{Binding BusyMessage}"
                                            FontSize="11" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1"
                                              Name="BusyProgress"
                                              AutomationProperties.AutomationId="BusyProgress"
                                              IsIndeterminate="True" Height="4"
                                              VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                         Name="CancelOperationButton"
                                         AutomationProperties.AutomationId="CancelOperationButton"
                                         Command="{Binding CancelOperationCommand}"
                                         IsVisible="{Binding CanCancelOperation}"
                                         ToolTip.Tip="Cancel the running operation"
                                         Padding="8,1" FontSize="11">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <materialIcons:MaterialIcon Kind="Cancel" Width="12" Height="12" />
                                        <TextBlock Text="Cancel" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.DataTemplates>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
