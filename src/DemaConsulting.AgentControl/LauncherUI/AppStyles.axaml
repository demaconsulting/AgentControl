<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <!-- App-wide theme resources and shared styles: the repo list and its cards, chips, action
         buttons and the Add menu, plus the semantic colors every window uses. Every color, shadow
         and focus ring lives in the Light and Dark theme dictionaries below and is consumed with
         DynamicResource, so the controls follow the theme variant (the user's Appearance setting)
         and no template or setter carries a hard-coded color. Chip text, button text, validation
         text and avatar letters aim for WCAG AA contrast (4.5:1) against their own fill and the
         surface they sit on; status accents and icons for 3:1. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <!-- Page, list and card surfaces -->
                    <SolidColorBrush x:Key="RepoListBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="RepoCardBackground" Color="#1E1E21" />
                    <SolidColorBrush x:Key="RepoCardBackgroundHover" Color="#26262A" />
                    <SolidColorBrush x:Key="RepoCardBorder" Color="#34343A" />
                    <SolidColorBrush x:Key="RepoCardBorderHover" Color="#52525C" />
                    <SolidColorBrush x:Key="RepoCardBorderSelected" Color="{DynamicResource SystemAccentColor}" />
                    <BoxShadows x:Key="RepoCardShadow">0 2 8 0 #66000000</BoxShadows>
                    <BoxShadows x:Key="RepoCardShadowHover">0 6 16 0 #80000000</BoxShadows>
                    <BoxShadows x:Key="RepoCardShadowSelected">0 0 0 1 #660078D4, 0 6 16 0 #80000000</BoxShadows>
                    <BoxShadows x:Key="FocusRingShadow">0 0 0 2 #7CB7FF</BoxShadows>

                    <!-- Window-level semantic colors used by every window: surfaces, dividers, and
                         the text colors of validation (error), caution (warning) and success -->
                    <SolidColorBrush x:Key="SurfaceBorder" Color="#4A4A52" />
                    <SolidColorBrush x:Key="PageBackground" Color="#141416" />
                    <SolidColorBrush x:Key="MenuGroupHeaderForeground" Color="#A8A8B4" />
                    <SolidColorBrush x:Key="GroupHeaderForeground" Color="#E6E6EA" />
                    <SolidColorBrush x:Key="SurfaceDivider" Color="#3A3A42" />
                    <SolidColorBrush x:Key="AppBarBackground" Color="#1B1B1F" />
                    <SolidColorBrush x:Key="ErrorForeground" Color="#FF8A80" />
                    <SolidColorBrush x:Key="WarningForeground" Color="#F2C14E" />
                    <SolidColorBrush x:Key="SuccessForeground" Color="#56D364" />
                    <SolidColorBrush x:Key="LinkForeground" Color="#7CB7FF" />
                    <SolidColorBrush x:Key="LogoBackingBackground" Color="#FFFFFF" />

                    <!-- Status accent bar -->
                    <SolidColorBrush x:Key="StatusAccentUpToDate" Color="#3FB950" />
                    <SolidColorBrush x:Key="StatusAccentUpgrade" Color="#E3A008" />
                    <SolidColorBrush x:Key="StatusAccentProblem" Color="#F85149" />
                    <SolidColorBrush x:Key="StatusAccentNeutral" Color="#6E7681" />

                    <!-- Chips: low-alpha tint of the hue, matching readable foreground -->
                    <SolidColorBrush x:Key="ChipNeutralBackground" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ChipNeutralBorder" Color="#3DFFFFFF" />
                    <SolidColorBrush x:Key="ChipNeutralForeground" Color="#E6E6EA" />
                    <SolidColorBrush x:Key="ChipGreyBackground" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ChipGreyBackgroundHover" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="ChipGreyBorder" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ChipGreyBorderHover" Color="#55FFFFFF" />
                    <SolidColorBrush x:Key="ChipGreyForeground" Color="#B4B4BE" />
                    <SolidColorBrush x:Key="ChipPackageBackground" Color="#334DA3FF" />
                    <SolidColorBrush x:Key="ChipPackageBorder" Color="#664DA3FF" />
                    <SolidColorBrush x:Key="ChipPackageForeground" Color="#9CCBFF" />
                    <SolidColorBrush x:Key="ChipAmberBackground" Color="#40F5A623" />
                    <SolidColorBrush x:Key="ChipAmberBackgroundHover" Color="#59F5A623" />
                    <SolidColorBrush x:Key="ChipAmberBackgroundPressed" Color="#66F5A623" />
                    <SolidColorBrush x:Key="ChipAmberBorder" Color="#80F5A623" />
                    <SolidColorBrush x:Key="ChipAmberBorderHover" Color="#F5A623" />
                    <SolidColorBrush x:Key="ChipAmberForeground" Color="#FFD479" />
                    <SolidColorBrush x:Key="ChipRedBackground" Color="#40F85149" />
                    <SolidColorBrush x:Key="ChipRedBorder" Color="#80F85149" />
                    <SolidColorBrush x:Key="ChipRedForeground" Color="#FFA198" />

                    <!-- Buttons: primary (accent), secondary (tinted outline), ghost (icon only) -->
                    <SolidColorBrush x:Key="ButtonPrimaryBackground" Color="{DynamicResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="ButtonPrimaryBackgroundHover" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ButtonPrimaryBackgroundPressed" Color="{DynamicResource SystemAccentColorDark2}" />
                    <SolidColorBrush x:Key="ButtonPrimaryForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonPrimaryBackgroundDisabled" Color="#2E2E34" />
                    <SolidColorBrush x:Key="ButtonPrimaryForegroundDisabled" Color="#9C9CA6" />
                    <SolidColorBrush x:Key="ButtonSecondaryBackground" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ButtonSecondaryBackgroundHover" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="ButtonSecondaryBackgroundPressed" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="ButtonSecondaryBackgroundDisabled" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="ButtonSecondaryBorder" Color="#47FFFFFF" />
                    <SolidColorBrush x:Key="ButtonSecondaryBorderHover" Color="#70FFFFFF" />
                    <SolidColorBrush x:Key="ButtonSecondaryBorderDisabled" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ButtonSecondaryForeground" Color="#ECECF0" />
                    <SolidColorBrush x:Key="ButtonSecondaryForegroundDisabled" Color="#9A9AA6" />
                    <SolidColorBrush x:Key="IconGhostBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="IconGhostBackgroundHover" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="IconGhostBackgroundPressed" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="IconGhostForeground" Color="#C8C8D0" />
                    <SolidColorBrush x:Key="IconGhostForegroundHover" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="IconGhostForegroundDisabled" Color="#6A6A74" />
                    <SolidColorBrush x:Key="FavoriteStarForeground" Color="#FFC83D" />

                    <!-- Empty state -->
                    <SolidColorBrush x:Key="EmptyStateTileBackground" Color="#334DA3FF" />
                    <SolidColorBrush x:Key="EmptyStateTileForeground" Color="#9CCBFF" />

                    <!-- Avatar palette: tile color and the letter color chosen for contrast -->
                    <SolidColorBrush x:Key="AvatarBackground0" Color="#2F6FDE" />
                    <SolidColorBrush x:Key="AvatarForeground0" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground1" Color="#7B4FE0" />
                    <SolidColorBrush x:Key="AvatarForeground1" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground2" Color="#C43C87" />
                    <SolidColorBrush x:Key="AvatarForeground2" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground3" Color="#187A50" />
                    <SolidColorBrush x:Key="AvatarForeground3" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground4" Color="#E0A21B" />
                    <SolidColorBrush x:Key="AvatarForeground4" Color="#111114" />
                    <SolidColorBrush x:Key="AvatarBackground5" Color="#157A8F" />
                    <SolidColorBrush x:Key="AvatarForeground5" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground6" Color="#D9692B" />
                    <SolidColorBrush x:Key="AvatarForeground6" Color="#111114" />
                    <SolidColorBrush x:Key="AvatarBackground7" Color="#5B5BD6" />
                    <SolidColorBrush x:Key="AvatarForeground7" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground8" Color="#C2374F" />
                    <SolidColorBrush x:Key="AvatarForeground8" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground9" Color="#8DBE2F" />
                    <SolidColorBrush x:Key="AvatarForeground9" Color="#111114" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="RepoListBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="RepoCardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RepoCardBackgroundHover" Color="#FBFBFD" />
                    <SolidColorBrush x:Key="RepoCardBorder" Color="#DCDCE2" />
                    <SolidColorBrush x:Key="RepoCardBorderHover" Color="#A9A9B8" />
                    <SolidColorBrush x:Key="RepoCardBorderSelected" Color="{DynamicResource SystemAccentColor}" />
                    <BoxShadows x:Key="RepoCardShadow">0 1 3 0 #1F000000</BoxShadows>
                    <BoxShadows x:Key="RepoCardShadowHover">0 6 16 0 #29000000</BoxShadows>
                    <BoxShadows x:Key="RepoCardShadowSelected">0 0 0 1 #660078D4, 0 6 16 0 #29000000</BoxShadows>
                    <BoxShadows x:Key="FocusRingShadow">0 0 0 2 #0A5FC4</BoxShadows>

                    <SolidColorBrush x:Key="SurfaceBorder" Color="#A0A0AC" />
                    <SolidColorBrush x:Key="PageBackground" Color="#F3F3F6" />
                    <SolidColorBrush x:Key="MenuGroupHeaderForeground" Color="#5C5C66" />
                    <SolidColorBrush x:Key="GroupHeaderForeground" Color="#2B2B30" />
                    <SolidColorBrush x:Key="SurfaceDivider" Color="#D0D0D8" />
                    <SolidColorBrush x:Key="AppBarBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ErrorForeground" Color="#B42318" />
                    <SolidColorBrush x:Key="WarningForeground" Color="#7A4A00" />
                    <SolidColorBrush x:Key="SuccessForeground" Color="#17692D" />
                    <SolidColorBrush x:Key="LinkForeground" Color="#0A5FC4" />
                    <SolidColorBrush x:Key="LogoBackingBackground" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="StatusAccentUpToDate" Color="#1A7F37" />
                    <SolidColorBrush x:Key="StatusAccentUpgrade" Color="#BF8700" />
                    <SolidColorBrush x:Key="StatusAccentProblem" Color="#CF222E" />
                    <SolidColorBrush x:Key="StatusAccentNeutral" Color="#8C959F" />

                    <SolidColorBrush x:Key="ChipNeutralBackground" Color="#0F000000" />
                    <SolidColorBrush x:Key="ChipNeutralBorder" Color="#26000000" />
                    <SolidColorBrush x:Key="ChipNeutralForeground" Color="#2B2B30" />
                    <SolidColorBrush x:Key="ChipGreyBackground" Color="#0A000000" />
                    <SolidColorBrush x:Key="ChipGreyBackgroundHover" Color="#14000000" />
                    <SolidColorBrush x:Key="ChipGreyBorder" Color="#1F000000" />
                    <SolidColorBrush x:Key="ChipGreyBorderHover" Color="#4D000000" />
                    <SolidColorBrush x:Key="ChipGreyForeground" Color="#5C5C66" />
                    <SolidColorBrush x:Key="ChipPackageBackground" Color="#1A0A6CC8" />
                    <SolidColorBrush x:Key="ChipPackageBorder" Color="#590A6CC8" />
                    <SolidColorBrush x:Key="ChipPackageForeground" Color="#0A5AA8" />
                    <SolidColorBrush x:Key="ChipAmberBackground" Color="#26D98F00" />
                    <SolidColorBrush x:Key="ChipAmberBackgroundHover" Color="#38D98F00" />
                    <SolidColorBrush x:Key="ChipAmberBackgroundPressed" Color="#4DD98F00" />
                    <SolidColorBrush x:Key="ChipAmberBorder" Color="#80D98F00" />
                    <SolidColorBrush x:Key="ChipAmberBorderHover" Color="#B77A00" />
                    <SolidColorBrush x:Key="ChipAmberForeground" Color="#6B4100" />
                    <SolidColorBrush x:Key="ChipRedBackground" Color="#1ACF222E" />
                    <SolidColorBrush x:Key="ChipRedBorder" Color="#66CF222E" />
                    <SolidColorBrush x:Key="ChipRedForeground" Color="#A5161F" />

                    <SolidColorBrush x:Key="ButtonPrimaryBackground" Color="{DynamicResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="ButtonPrimaryBackgroundHover" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ButtonPrimaryBackgroundPressed" Color="{DynamicResource SystemAccentColorDark2}" />
                    <SolidColorBrush x:Key="ButtonPrimaryForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonPrimaryBackgroundDisabled" Color="#E6E6EA" />
                    <SolidColorBrush x:Key="ButtonPrimaryForegroundDisabled" Color="#5E5E6A" />
                    <SolidColorBrush x:Key="ButtonSecondaryBackground" Color="#0A000000" />
                    <SolidColorBrush x:Key="ButtonSecondaryBackgroundHover" Color="#14000000" />
                    <SolidColorBrush x:Key="ButtonSecondaryBackgroundPressed" Color="#1F000000" />
                    <SolidColorBrush x:Key="ButtonSecondaryBackgroundDisabled" Color="#05000000" />
                    <SolidColorBrush x:Key="ButtonSecondaryBorder" Color="#33000000" />
                    <SolidColorBrush x:Key="ButtonSecondaryBorderHover" Color="#59000000" />
                    <SolidColorBrush x:Key="ButtonSecondaryBorderDisabled" Color="#14000000" />
                    <SolidColorBrush x:Key="ButtonSecondaryForeground" Color="#1F1F24" />
                    <SolidColorBrush x:Key="ButtonSecondaryForegroundDisabled" Color="#6B6B76" />
                    <SolidColorBrush x:Key="IconGhostBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="IconGhostBackgroundHover" Color="#12000000" />
                    <SolidColorBrush x:Key="IconGhostBackgroundPressed" Color="#1F000000" />
                    <SolidColorBrush x:Key="IconGhostForeground" Color="#4A4A55" />
                    <SolidColorBrush x:Key="IconGhostForegroundHover" Color="#1F1F24" />
                    <SolidColorBrush x:Key="IconGhostForegroundDisabled" Color="#9A9AA6" />
                    <SolidColorBrush x:Key="FavoriteStarForeground" Color="#B77A00" />

                    <SolidColorBrush x:Key="EmptyStateTileBackground" Color="#1A0A6CC8" />
                    <SolidColorBrush x:Key="EmptyStateTileForeground" Color="#0A5AA8" />

                    <SolidColorBrush x:Key="AvatarBackground0" Color="#2563EB" />
                    <SolidColorBrush x:Key="AvatarForeground0" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground1" Color="#7C3AED" />
                    <SolidColorBrush x:Key="AvatarForeground1" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground2" Color="#C026D3" />
                    <SolidColorBrush x:Key="AvatarForeground2" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground3" Color="#047857" />
                    <SolidColorBrush x:Key="AvatarForeground3" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground4" Color="#D97706" />
                    <SolidColorBrush x:Key="AvatarForeground4" Color="#111114" />
                    <SolidColorBrush x:Key="AvatarBackground5" Color="#0E7490" />
                    <SolidColorBrush x:Key="AvatarForeground5" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground6" Color="#C2410C" />
                    <SolidColorBrush x:Key="AvatarForeground6" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground7" Color="#4F46E5" />
                    <SolidColorBrush x:Key="AvatarForeground7" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground8" Color="#BE123C" />
                    <SolidColorBrush x:Key="AvatarForeground8" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBackground9" Color="#4D7C0F" />
                    <SolidColorBrush x:Key="AvatarForeground9" Color="#FFFFFF" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===== Every window sits on the theme's page background; cards float on it ===== -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource PageBackground}" />
    </Style>

    <!-- ===== Repo list: cards float on the page background (no slab behind them) ===== -->
    <Style Selector="ListBox.repoList">
        <Setter Property="Background" Value="{DynamicResource RepoListBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- Padding keeps the cards' soft shadow inside the scroll viewer; the negative margin
             in the window gives it back, so the cards stay aligned with the toolbar above -->
        <Setter Property="Padding" Value="8,0,8,0" />
    </Style>
    <Style Selector="ListBox.repoList ListBoxItem">
        <Setter Property="Padding" Value="0,5,0,5" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The card itself shows hover and selection, so the list row stays transparent in every
         state (Fluent would otherwise paint a grey band behind the card) -->
    <Style Selector="ListBox.repoList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.repoList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.repoList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.repoList ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.repoList ListBoxItem /template/ Rectangle#SelectionIndicator">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ===== Card: surface, depth, hover lift and selection ===== -->
    <Style Selector="Border.RepoCard">
        <Setter Property="Background" Value="{DynamicResource RepoCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RepoCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BoxShadow" Value="{DynamicResource RepoCardShadow}" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.RepoCard:pointerover">
        <Setter Property="Background" Value="{DynamicResource RepoCardBackgroundHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RepoCardBorderHover}" />
        <Setter Property="BoxShadow" Value="{DynamicResource RepoCardShadowHover}" />
        <Setter Property="RenderTransform" Value="translateY(-1px)" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.RepoCard">
        <Setter Property="BorderBrush" Value="{DynamicResource RepoCardBorderSelected}" />
        <Setter Property="BoxShadow" Value="{DynamicResource RepoCardShadowSelected}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.RepoCard:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource RepoCardBorderSelected}" />
        <Setter Property="BoxShadow" Value="{DynamicResource RepoCardShadowSelected}" />
    </Style>
    <Style Selector="ListBoxItem:focus-visible Border.RepoCard">
        <Setter Property="BoxShadow" Value="{DynamicResource FocusRingShadow}" />
    </Style>

    <!-- ===== Status accent bar on the card's left edge (grey unless a status class is set) ===== -->
    <Style Selector="Border.StatusAccent">
        <Setter Property="Width" Value="5" />
        <Setter Property="CornerRadius" Value="9,0,0,9" />
        <Setter Property="Background" Value="{DynamicResource StatusAccentNeutral}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.StatusAccent.statusUpToDate">
        <Setter Property="Background" Value="{DynamicResource StatusAccentUpToDate}" />
    </Style>
    <Style Selector="Border.StatusAccent.statusUpgrade">
        <Setter Property="Background" Value="{DynamicResource StatusAccentUpgrade}" />
    </Style>
    <Style Selector="Border.StatusAccent.statusProblem">
        <Setter Property="Background" Value="{DynamicResource StatusAccentProblem}" />
    </Style>

    <!-- ===== Avatar tile: the repo's initials on a stable per-repo color ===== -->
    <Style Selector="Border.Avatar">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AvatarBackground0}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AvatarForeground0}" />
    </Style>
    <Style Selector="Border.Avatar.avatar0">
        <Setter Property="BorderBrush" Value="{DynamicResource AvatarBackground0}" />
        <Setter Property="Background" Value="{DynamicResource AvatarBackground0}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AvatarForeground0}" />
    </Style>
    <Style Selector="Border.Avatar.avatar1">
        <Setter Property="BorderBrush" Value="{DynamicResource AvatarBackground1}" />
        <Setter Property="Background" Value="{DynamicResource AvatarBackground1}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AvatarForeground1}" />
    </Style>
    <Style Selector="Border.Avatar.avatar2">
        <Setter Property="BorderBrush" Value="{DynamicResource AvatarBackground2}" />
        <Setter Property="Background" Value="{DynamicResource AvatarBackground2}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AvatarForeground2}" />
    </Style>
    <Style Selector="Border.Avatar.avatar3">
        <Setter Property="BorderBrush" Value="{DynamicResource AvatarBackground3}" />
        <Setter Property="Background" Value="{DynamicResource AvatarBackground3}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AvatarForeground3}" />
    </Style>
    <Style Selector="Border.Avatar.avatar4">
        <Setter Property="BorderBrush" Value="{DynamicResource AvatarBackground4}" />
        <Setter Property="Background" Value="{DynamicResource AvatarBackground4}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AvatarForeground4}" />
    </Style>
    <Style Selector="Border.Avatar.avatar5">
        <Setter Property="BorderBrush" Value="{DynamicResource AvatarBackground5}" />
        <Setter Property="Background" Value="{DynamicResource AvatarBackground5}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AvatarForeground5}" />
    </Style>
    <Style Selector="Border.Avatar.avatar6">
        <Setter Property="BorderBrush" Value="{DynamicResource AvatarBackground6}" />
        <Setter Property="Background" Value="{DynamicResource AvatarBackground6}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AvatarForeground6}" />
    </Style>
    <Style Selector="Border.Avatar.avatar7">
        <Setter Property="BorderBrush" Value="{DynamicResource AvatarBackground7}" />
        <Setter Property="Background" Value="{DynamicResource AvatarBackground7}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AvatarForeground7}" />
    </Style>
    <Style Selector="Border.Avatar.avatar8">
        <Setter Property="BorderBrush" Value="{DynamicResource AvatarBackground8}" />
        <Setter Property="Background" Value="{DynamicResource AvatarBackground8}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AvatarForeground8}" />
    </Style>
    <Style Selector="Border.Avatar.avatar9">
        <Setter Property="BorderBrush" Value="{DynamicResource AvatarBackground9}" />
        <Setter Property="Background" Value="{DynamicResource AvatarBackground9}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AvatarForeground9}" />
    </Style>

    <!-- A repo's own picture sits on a light backing (as the application's own logo does), so
         logos drawn for a white page stay legible in the dark theme, and a border sets the tile
         apart from the card. Defined after the palette classes so it wins over them. -->
    <Style Selector="Border.Avatar.hasImage">
        <Setter Property="Background" Value="{DynamicResource LogoBackingBackground}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.Avatar.hasImage:not(.customColor)">
        <Setter Property="BorderBrush" Value="{DynamicResource RepoCardBorderHover}" />
    </Style>
    <!-- A color the user chose for a repo that has a picture shows as a ring around the picture's
         tile (the ring takes its color from the palette class), so the picture keeps its light
         backing and stays legible while the card still carries the chosen color -->
    <Style Selector="Border.Avatar.hasImage.customColor">
        <Setter Property="BorderThickness" Value="3" />
    </Style>

    <!-- ===== Empty state ===== -->
    <Style Selector="Border.EmptyState">
        <Setter Property="Background" Value="{DynamicResource RepoCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RepoCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BoxShadow" Value="{DynamicResource RepoCardShadow}" />
        <Setter Property="Padding" Value="36,28" />
    </Style>
    <Style Selector="Border.EmptyStateTile">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{DynamicResource EmptyStateTileBackground}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource EmptyStateTileForeground}" />
    </Style>

    <!-- ===== Card menu: group headers are disabled items drawn as small captions ===== -->
    <Style Selector="MenuItem.groupHeader">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,6,8,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MenuGroupHeaderForeground}" />
    </Style>
    <Style Selector="MenuItem.groupHeader:disabled /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource MenuGroupHeaderForeground}" />
    </Style>

    <!-- ===== Chips: one height, padding and font; tinted fill with a matching foreground ===== -->
    <Style Selector="Border.Chip">
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="{DynamicResource ChipNeutralBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipNeutralBorder}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ChipNeutralForeground}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.13" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.13" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.Chip.grey">
        <Setter Property="Background" Value="{DynamicResource ChipGreyBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipGreyBorder}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ChipGreyForeground}" />
    </Style>
    <Style Selector="Border.Chip.package">
        <Setter Property="Background" Value="{DynamicResource ChipPackageBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipPackageBorder}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ChipPackageForeground}" />
    </Style>
    <Style Selector="Border.Chip.amber">
        <Setter Property="Background" Value="{DynamicResource ChipAmberBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipAmberBorder}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ChipAmberForeground}" />
    </Style>
    <Style Selector="Border.Chip.red">
        <Setter Property="Background" Value="{DynamicResource ChipRedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipRedBorder}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ChipRedForeground}" />
    </Style>
    <Style Selector="Border.Chip TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.Chip materialIcons|MaterialIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A clickable chip is a flat button wrapping a chip: the chip itself shows hover, press and
         keyboard focus, with color changes only so nothing around it moves -->
    <Style Selector="Button.chipButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chipButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.chipButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.chipButton:pointerover Border.Chip.amber">
        <Setter Property="Background" Value="{DynamicResource ChipAmberBackgroundHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipAmberBorderHover}" />
    </Style>
    <Style Selector="Button.chipButton:pressed Border.Chip.amber">
        <Setter Property="Background" Value="{DynamicResource ChipAmberBackgroundPressed}" />
    </Style>
    <Style Selector="Button.chipButton:pointerover Border.Chip.grey">
        <Setter Property="Background" Value="{DynamicResource ChipGreyBackgroundHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipGreyBorderHover}" />
    </Style>
    <Style Selector="Button.chipButton:focus-visible Border.Chip">
        <Setter Property="BoxShadow" Value="{DynamicResource FocusRingShadow}" />
    </Style>
    <Style Selector="Button.chipButton:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- ===== Links: a flat button showing underlined link-colored text, used for Markdown links in the
         release notes; keyboard focus draws a ring around the text ===== -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LinkForeground}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Button.link:focus-visible Border">
        <Setter Property="BoxShadow" Value="{DynamicResource FocusRingShadow}" />
    </Style>

    <!-- ===== Action buttons: one height, radius and icon-plus-text layout ===== -->
    <Style Selector="Button.actionButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.actionButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.13" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.13" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.actionButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource FocusRingShadow}" />
    </Style>

    <!-- Primary: the accent-filled main action -->
    <Style Selector="Button.actionButton.primary">
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForeground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.actionButton.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForeground}" />
    </Style>
    <Style Selector="Button.actionButton.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundPressed}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForeground}" />
    </Style>
    <Style Selector="Button.actionButton.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundDisabled}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundDisabled}" />
    </Style>

    <!-- Secondary: a tinted outline, readable when disabled -->
    <Style Selector="Button.actionButton.secondary">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForeground}" />
    </Style>
    <Style Selector="Button.actionButton.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderHover}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForeground}" />
    </Style>
    <Style Selector="Button.actionButton.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderHover}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForeground}" />
    </Style>
    <Style Selector="Button.actionButton.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundDisabled}" />
    </Style>

    <!-- Ghost icon buttons (favorite star, more actions): borderless, subtle hover background -->
    <Style Selector="Button.iconGhost, ToggleButton.iconGhost">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource IconGhostBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource IconGhostForeground}" />
    </Style>
    <Style Selector="Button.iconGhost /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.iconGhost /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.13" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.iconGhost:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.iconGhost:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.iconGhost:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource IconGhostBackgroundHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource IconGhostForegroundHover}" />
    </Style>
    <Style Selector="Button.iconGhost:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.iconGhost:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.iconGhost:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource IconGhostBackgroundPressed}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource IconGhostForegroundHover}" />
    </Style>
    <Style Selector="ToggleButton.iconGhost:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource IconGhostBackground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.iconGhost:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.iconGhost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource IconGhostForegroundDisabled}" />
    </Style>
    <Style Selector="Button.iconGhost:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.iconGhost:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource FocusRingShadow}" />
    </Style>
    <!-- A favorited repo's star is filled gold; unfavorited it is an outline in the ghost color -->
    <Style Selector="ToggleButton.iconGhost:checked materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource FavoriteStarForeground}" />
    </Style>

    <!-- ===== Group headers: a section's name and count among the cards. The whole title is one
         flat button (chevron, icon, name, count) that collapses or expands the section. ===== -->
    <Style Selector="Button.groupToggle">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="6,0,10,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GroupHeaderForeground}" />
    </Style>
    <Style Selector="Button.groupToggle /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.13" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.groupToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource IconGhostBackgroundHover}" />
        <Setter Property="Foreground" Value="{DynamicResource GroupHeaderForeground}" />
    </Style>
    <Style Selector="Button.groupToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource IconGhostBackgroundPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource GroupHeaderForeground}" />
    </Style>
    <Style Selector="Button.groupToggle:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GroupHeaderForeground}" />
    </Style>
    <Style Selector="Button.groupToggle:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource FocusRingShadow}" />
    </Style>
    <Style Selector="Button.groupToggle materialIcons|MaterialIcon.chevron">
        <Setter Property="Foreground" Value="{DynamicResource MenuGroupHeaderForeground}" />
    </Style>

    <!-- ===== Card color palette: round swatches filled with the avatar palette's colors. A
         swatch keeps its fill on hover and press (only its ring changes), and the chosen one shows
         a check mark in the letter color of its fill, so the choice is not carried by color alone. ===== -->
    <Style Selector="Button.swatch">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AvatarBackground0}" />
        <Setter Property="Foreground" Value="{DynamicResource AvatarForeground0}" />
    </Style>
    <Style Selector="Button.swatch.avatar0">
        <Setter Property="Background" Value="{DynamicResource AvatarBackground0}" />
        <Setter Property="Foreground" Value="{DynamicResource AvatarForeground0}" />
    </Style>
    <Style Selector="Button.swatch.avatar1">
        <Setter Property="Background" Value="{DynamicResource AvatarBackground1}" />
        <Setter Property="Foreground" Value="{DynamicResource AvatarForeground1}" />
    </Style>
    <Style Selector="Button.swatch.avatar2">
        <Setter Property="Background" Value="{DynamicResource AvatarBackground2}" />
        <Setter Property="Foreground" Value="{DynamicResource AvatarForeground2}" />
    </Style>
    <Style Selector="Button.swatch.avatar3">
        <Setter Property="Background" Value="{DynamicResource AvatarBackground3}" />
        <Setter Property="Foreground" Value="{DynamicResource AvatarForeground3}" />
    </Style>
    <Style Selector="Button.swatch.avatar4">
        <Setter Property="Background" Value="{DynamicResource AvatarBackground4}" />
        <Setter Property="Foreground" Value="{DynamicResource AvatarForeground4}" />
    </Style>
    <Style Selector="Button.swatch.avatar5">
        <Setter Property="Background" Value="{DynamicResource AvatarBackground5}" />
        <Setter Property="Foreground" Value="{DynamicResource AvatarForeground5}" />
    </Style>
    <Style Selector="Button.swatch.avatar6">
        <Setter Property="Background" Value="{DynamicResource AvatarBackground6}" />
        <Setter Property="Foreground" Value="{DynamicResource AvatarForeground6}" />
    </Style>
    <Style Selector="Button.swatch.avatar7">
        <Setter Property="Background" Value="{DynamicResource AvatarBackground7}" />
        <Setter Property="Foreground" Value="{DynamicResource AvatarForeground7}" />
    </Style>
    <Style Selector="Button.swatch.avatar8">
        <Setter Property="Background" Value="{DynamicResource AvatarBackground8}" />
        <Setter Property="Foreground" Value="{DynamicResource AvatarForeground8}" />
    </Style>
    <Style Selector="Button.swatch.avatar9">
        <Setter Property="Background" Value="{DynamicResource AvatarBackground9}" />
        <Setter Property="Foreground" Value="{DynamicResource AvatarForeground9}" />
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IconGhostForeground}" />
    </Style>
    <Style Selector="Button.swatch.selected /template/ ContentPresenter#PART_ContentPresenter, Button.swatch.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource IconGhostForegroundHover}" />
    </Style>
    <Style Selector="Button.swatch:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource FocusRingShadow}" />
    </Style>
    <Style Selector="Button.swatch materialIcons|MaterialIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.swatch.selected materialIcons|MaterialIcon">
        <Setter Property="IsVisible" Value="True" />
    </Style>
</Styles>
