<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DemaConsulting.AgentControl.LauncherUI"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="480" d:DesignHeight="420"
        x:Class="DemaConsulting.AgentControl.LauncherUI.CredentialPromptWindow"
        x:DataType="vm:CredentialPromptViewModel"
        Name="CredentialPromptRoot"
        Title="Sign in to package source"
        Width="480" SizeToContent="Height"
        MinWidth="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="materialIcons|MaterialIcon.secureIcon">
            <Setter Property="Foreground" Value="#2EA043" />
        </Style>
        <Style Selector="materialIcons|MaterialIcon.warnIcon">
            <Setter Property="Foreground" Value="#D29922" />
        </Style>
    </Window.Styles>
    <StackPanel Margin="16" Spacing="8">

        <!-- Which server receives what is typed here: shown large and first, so the user can
             check it before typing anything (a look-alike server is the classic phishing trap) -->
        <TextBlock Text="Sign in to" FontSize="12" Opacity="0.65" />
        <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="4" Padding="10,8"
                 ToolTip.Tip="The server that receives the user name and password you type here">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Kind="Lock" Width="22" Height="22"
                                              VerticalAlignment="Center"
                                              Classes="secureIcon"
                                              IsVisible="{Binding !IsInsecure}" />
                <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="22" Height="22"
                                              VerticalAlignment="Center"
                                              Classes="warnIcon"
                                              IsVisible="{Binding IsInsecure}" />
                <TextBlock Name="CredentialPromptOriginText"
                            AutomationProperties.AutomationId="CredentialPromptOriginText"
                            Text="{Binding OriginText}"
                            FontSize="18" FontWeight="Bold"
                            VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Name="CredentialPromptExplanationText"
                    AutomationProperties.AutomationId="CredentialPromptExplanationText"
                    Text="{Binding Explanation}"
                    TextWrapping="Wrap" />

        <TextBlock Name="CredentialPromptInsecureText"
                    AutomationProperties.AutomationId="CredentialPromptInsecureText"
                    IsVisible="{Binding IsInsecure}"
                    Text="This server uses plain http, so what you type is not encrypted on the network."
                    Foreground="#D29922" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TextBlock Name="CredentialPromptRejectedText"
                    AutomationProperties.AutomationId="CredentialPromptRejectedText"
                    IsVisible="{Binding PreviousCredentialRejected}"
                    Text="The server rejected the last sign-in. Check the user name and the password or token and try again."
                    Foreground="Red" TextWrapping="Wrap" />

        <TextBlock Text="User name" FontWeight="Bold" Margin="0,8,0,0" />
        <TextBox Name="CredentialPromptUserNameTextBox"
                  AutomationProperties.AutomationId="CredentialPromptUserNameTextBox"
                  ToolTip.Tip="The user name (or e-mail address) of your account on this server"
                  Text="{Binding UserName}" />

        <TextBlock Text="Password or access token" FontWeight="Bold" Margin="0,4,0,0" />
        <TextBox Name="CredentialPromptPasswordTextBox"
                  AutomationProperties.AutomationId="CredentialPromptPasswordTextBox"
                  ToolTip.Tip="Your password, or a personal access token; it is masked while you type"
                  PasswordChar="●"
                  Text="{Binding Password}">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SignInCommand}" />
            </TextBox.KeyBindings>
        </TextBox>

        <!-- Remember: opt-in, off by default; disabled (with an explanation on hover) when no Git
             credential helper is configured, because only that helper can keep the sign-in -->
        <CheckBox Name="CredentialPromptRememberCheckBox"
                   AutomationProperties.AutomationId="CredentialPromptRememberCheckBox"
                   Margin="0,4,0,0"
                   IsEnabled="{Binding CanRemember}"
                   IsChecked="{Binding Remember}"
                   ToolTip.Tip="{Binding RememberTooltip}"
                   ToolTip.ShowOnDisabled="True"
                   Content="{x:Static vm:CredentialPromptViewModel.RememberLabel}" />

        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
            <materialIcons:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="14" Height="14"
                                          VerticalAlignment="Top" Margin="0,2,6,0" Opacity="0.65" />
            <TextBlock Grid.Column="1"
                        Name="CredentialPromptSessionNoteText"
                        AutomationProperties.AutomationId="CredentialPromptSessionNoteText"
                        Text="{Binding NoteText}"
                        FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                        VerticalAlignment="Center" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Name="CredentialPromptCancelButton"
                     AutomationProperties.AutomationId="CredentialPromptCancelButton"
                     ToolTip.Tip="Close without signing in"
                     Content="Cancel"
                     Command="{Binding CancelCommand}" />
            <Button Name="CredentialPromptSignInButton"
                     AutomationProperties.AutomationId="CredentialPromptSignInButton"
                     ToolTip.Tip="Sign in to this server (available once a user name and a password are entered)"
                     ToolTip.ShowOnDisabled="True"
                     Classes="accent"
                     Content="Sign in"
                     Command="{Binding SignInCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
