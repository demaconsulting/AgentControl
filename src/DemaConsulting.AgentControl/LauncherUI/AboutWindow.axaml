<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="DemaConsulting.AgentControl.LauncherUI.AboutWindow"
        Name="AboutWindowRoot"
        Title="About Agent Control"
        Width="600" SizeToContent="Height"
        MaxHeight="640"
        MinWidth="280"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <!-- Three rows: the banner (fixed), everything else in one scrolling region (so a long
         dependency list or a longer license text never pushes the window off the screen), and the
         footer with Close (fixed, always in view). -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Banner: the logo, the name and the project tagline on a theme-keyed band, with two soft
             glows on the right and the brand gradient line along the bottom edge. Pure XAML with
             theme resources (AboutBanner* in AppStyles.axaml); no image asset of its own. -->
        <Border Grid.Row="0"
                Name="AboutBanner"
                AutomationProperties.AutomationId="AboutBanner"
                AutomationProperties.AccessibilityView="Content"
                AutomationProperties.Name="AgentControl: A Desktop Launcher for Distributing Proprietary Agent Packages"
                Background="{DynamicResource AboutBannerBackground}"
                ClipToBounds="True">
            <Panel>
                <!-- Decorative glows, away from the text and never hit-testable -->
                <Ellipse Width="260" Height="260"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,-90,-70,-90"
                         IsHitTestVisible="False"
                         AutomationProperties.AccessibilityView="Raw"
                         Fill="{DynamicResource AboutBannerGlowPrimary}" />
                <Ellipse Width="180" Height="180"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,-60,130,-60"
                         IsHitTestVisible="False"
                         AutomationProperties.AccessibilityView="Raw"
                         Fill="{DynamicResource AboutBannerGlowSecondary}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="20,20,20,23">
                    <!-- The AppIcon.ico logo has a black "D" on a transparent background, which
                         disappears against a dark band; the light backing tile keeps the full logo
                         visible regardless of theme. -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource LogoBackingBackground}"
                            CornerRadius="10" Padding="6" Width="56" Height="56"
                            VerticalAlignment="Center">
                        <Image Source="avares://DemaConsulting.AgentControl/Assets/AppIcon.ico"
                               AutomationProperties.AccessibilityView="Raw"
                               Width="44" Height="44" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Name="AboutBannerTitleText"
                                   AutomationProperties.AutomationId="AboutBannerTitleText"
                                   Text="AgentControl"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource AboutBannerForeground}" />
                        <TextBlock Name="AboutBannerTaglineText"
                                   AutomationProperties.AutomationId="AboutBannerTaglineText"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AboutBannerTaglineForeground}" />
                    </StackPanel>
                </Grid>

                <!-- The brand gradient line along the bottom edge -->
                <Border Height="3"
                        VerticalAlignment="Bottom"
                        IsHitTestVisible="False"
                        Background="{DynamicResource AboutBannerAccent}" />
            </Panel>
        </Border>

        <!-- The one scrolling region: what AgentControl is for, the version, copyright, license and
             the third-party dependencies, with room for longer license text later -->
        <ScrollViewer Grid.Row="1"
                      Name="AboutContentScroller"
                      AutomationProperties.AutomationId="AboutContentScroller"
                      MaxHeight="440"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,12" Spacing="8">
                <TextBlock Name="AboutTaglineText"
                           AutomationProperties.AutomationId="AboutTaglineText"
                           FontStyle="Italic"
                           TextWrapping="Wrap" />
                <!-- A labeled row: the semantic version, with the full build identifier (including
                     the build metadata) in the tooltip -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Version" FontWeight="SemiBold" />
                    <TextBlock Name="AboutVersionText"
                               AutomationProperties.AutomationId="AboutVersionText" />
                </StackPanel>
                <TextBlock Name="AboutCopyrightText"
                           AutomationProperties.AutomationId="AboutCopyrightText" />
                <TextBlock Name="AboutLicenseText"
                           AutomationProperties.AutomationId="AboutLicenseText"
                           TextWrapping="Wrap" />
                <TextBlock Text="Third-Party Dependencies" FontWeight="Bold" Margin="0,8,0,0" />
                <ItemsControl Name="AboutDependenciesList"
                              AutomationProperties.AutomationId="AboutDependenciesList" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: Close, always in view below the scrolling region -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SurfaceDivider}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Button Name="AboutCloseButton"
                    AutomationProperties.AutomationId="AboutCloseButton"
                    Content="Close"
                    Click="CloseButton_Click"
                    HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
