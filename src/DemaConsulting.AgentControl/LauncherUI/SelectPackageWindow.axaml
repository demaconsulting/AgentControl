<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DemaConsulting.AgentControl.LauncherUI"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="780" d:DesignHeight="470"
        x:Class="DemaConsulting.AgentControl.LauncherUI.SelectPackageWindow"
        x:DataType="vm:SelectPackageWindowViewModel"
        Name="SelectPackageRoot"
        Title="Select Package"
        Width="780" Height="470"
        MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <!-- A source that could not be read is shown in red, like an inline error -->
        <Style Selector="TextBlock.sourceFailed">
            <Setter Property="Foreground" Value="#E5534B" />
        </Style>
    </Window.Styles>
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">

        <TextBlock Grid.Row="0"
                    Text="Choose the source the agent package comes from, then the package and its version."
                    FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

        <!-- Indeterminate progress while a source or a package's versions are being read; the
             window stays usable meanwhile -->
        <ProgressBar Grid.Row="1"
                      Name="SelectPackageProgress"
                      AutomationProperties.AutomationId="SelectPackageProgress"
                      IsIndeterminate="True"
                      Height="4"
                      IsVisible="{Binding IsLoading}" />

        <!-- Three columns read left to right: source, package, version. A package is only identified
             together with its source, so the source comes first. -->
        <Grid Grid.Row="2" ColumnDefinitions="1.15*,1*,0.7*" ColumnSpacing="12">

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="1. Source" FontWeight="Bold" Margin="0,0,0,4" />
                <ListBox Name="SelectPackageSourceList"
                          AutomationProperties.AutomationId="SelectPackageSourceList"
                          ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SelectPackageSourceViewModel">
                            <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Location}">
                                <materialIcons:MaterialIcon Grid.Column="0"
                                                              Kind="{Binding TypeIcon}"
                                                              Width="22" Height="22"
                                                              Margin="0,0,8,0"
                                                              VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Name="SelectPackageSourceAliasText"
                                                AutomationProperties.AutomationId="SelectPackageSourceAliasText"
                                                Text="{Binding Alias}" FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding TypeName}" FontSize="11" Opacity="0.6" />
                                        <TextBlock Name="SelectPackageSourceStatusText"
                                                    AutomationProperties.AutomationId="SelectPackageSourceStatusText"
                                                    Text="{Binding StatusText}" FontSize="11"
                                                    Classes.sourceFailed="{Binding HasError}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="2. Package" FontWeight="Bold" Margin="0,0,0,4" />
                <Grid>
                    <ListBox Name="SelectPackageNameList"
                              AutomationProperties.AutomationId="SelectPackageNameList"
                              ItemsSource="{Binding PackageNames}"
                              SelectedItem="{Binding SelectedPackageName, Mode=TwoWay}" />
                    <StackPanel IsVisible="{Binding HasSourceError}" Margin="8" Spacing="6"
                                 VerticalAlignment="Top">
                        <TextBlock Name="SelectPackageSourceErrorText"
                                    AutomationProperties.AutomationId="SelectPackageSourceErrorText"
                                    Text="{Binding SourceErrorMessage}"
                                    Classes="sourceFailed"
                                    TextWrapping="Wrap" />
                        <Button Name="SelectPackageSourceRetryButton"
                                 AutomationProperties.AutomationId="SelectPackageSourceRetryButton"
                                 ToolTip.Tip="Read this source again"
                                 Command="{Binding RetryCommand}"
                                 HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Refresh" />
                                <TextBlock Text="Retry" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Name="SelectPackageEmptyText"
                                AutomationProperties.AutomationId="SelectPackageEmptyText"
                                IsVisible="{Binding HasNoPackages}"
                                Text="This source offers no packages."
                                Opacity="0.65" TextWrapping="Wrap" Margin="8"
                                VerticalAlignment="Top" />
                </Grid>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="3. Version" FontWeight="Bold" Margin="0,0,0,4" />
                <Grid>
                    <ListBox Name="SelectPackageVersionList"
                              AutomationProperties.AutomationId="SelectPackageVersionList"
                              ItemsSource="{Binding AvailableVersions}"
                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" />
                    <StackPanel IsVisible="{Binding HasVersionsError}" Margin="8" Spacing="6"
                                 VerticalAlignment="Top">
                        <TextBlock Name="SelectPackageVersionsErrorText"
                                    AutomationProperties.AutomationId="SelectPackageVersionsErrorText"
                                    Text="{Binding VersionsError}"
                                    Classes="sourceFailed"
                                    TextWrapping="Wrap" />
                        <Button Name="SelectPackageVersionsRetryButton"
                                 AutomationProperties.AutomationId="SelectPackageVersionsRetryButton"
                                 ToolTip.Tip="Read the versions again (a server that needs a sign-in asks again)"
                                 Command="{Binding RetryCommand}"
                                 HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Refresh" />
                                <TextBlock Text="Retry" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ProgressBar Name="SelectPackageVersionsProgress"
                                  AutomationProperties.AutomationId="SelectPackageVersionsProgress"
                                  IsIndeterminate="True" Height="4"
                                  VerticalAlignment="Top"
                                  IsVisible="{Binding IsLoadingVersions}" />
                </Grid>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="SelectPackageCancelButton"
                     AutomationProperties.AutomationId="SelectPackageCancelButton"
                     ToolTip.Tip="Close without selecting a package"
                     Content="Cancel"
                     Click="CancelButton_Click" />
            <Button Name="SelectPackageConfirmButton"
                     AutomationProperties.AutomationId="SelectPackageConfirmButton"
                     ToolTip.Tip="Pin the repo to the selected package and version (choose a source, package and version first)"
                     ToolTip.ShowOnDisabled="True"
                     Classes="accent"
                     Content="Select"
                     Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</Window>
