<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DemaConsulting.AgentControl.LauncherUI.MessageBoxWindow"
        Name="MessageBoxRoot"
        Title="AgentControl"
        Width="420" SizeToContent="Height"
        MinWidth="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="16">
        <TextBlock Name="MessageText"
                    AutomationProperties.AutomationId="MessageText"
                    TextWrapping="Wrap" />
        <Button Name="MessageBoxOkButton"
                 AutomationProperties.AutomationId="MessageBoxOkButton"
                 Content="OK"
                 HorizontalAlignment="Right"
                 Click="OkButton_Click" />
    </StackPanel>
</Window>
