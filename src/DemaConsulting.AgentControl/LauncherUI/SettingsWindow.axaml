<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DemaConsulting.AgentControl.LauncherUI"
        xmlns:settings="using:DemaConsulting.AgentControl.Settings"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="600" d:DesignHeight="640"
        x:Class="DemaConsulting.AgentControl.LauncherUI.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Name="SettingsWindowRoot"
        Title="AgentControl Settings"
        Width="800" SizeToContent="Height"
        MinWidth="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <!-- Status colors for the sources list: found = green, not found = red. Mid-tone values
             stay readable on both the light and the dark theme. -->
        <Style Selector="materialIcons|MaterialIcon.sourceAvailable">
            <Setter Property="Foreground" Value="#2EA043" />
        </Style>
        <Style Selector="materialIcons|MaterialIcon.sourceMissing">
            <Setter Property="Foreground" Value="#E5534B" />
        </Style>
    </Window.Styles>
    <StackPanel Margin="16" Spacing="12">

        <!-- Package sources: where agent packages come from. Each repo is pinned to one source by
             its alias. Edit and Remove act on the selected row, so they sit on the header line right
             above the list; the three add buttons share one row below it. -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Package sources" FontWeight="Bold" FontSize="15"
                        VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Name="EditSourceButton"
                         AutomationProperties.AutomationId="EditSourceButton"
                         Command="{Binding EditSourceCommand}"
                         ToolTip.Tip="Edit the selected source"
                         ToolTip.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="PencilOutline" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button Name="RemoveSourceButton"
                         AutomationProperties.AutomationId="RemoveSourceButton"
                         Command="{Binding RemoveSourceCommand}"
                         ToolTip.Tip="Remove the selected source"
                         ToolTip.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="TrashCanOutline" />
                        <TextBlock Text="Remove" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <TextBlock Text="Agent packages are read from these sources. A repo is pinned to one source by its alias. Select a source to edit or remove it."
                    FontSize="11" Opacity="0.65" TextWrapping="Wrap" />

        <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="4" MinHeight="120">
            <Grid>
                <TextBlock Name="SourcesEmptyText"
                            AutomationProperties.AutomationId="SourcesEmptyText"
                            IsVisible="{Binding HasNoSources}"
                            Text="No package sources yet. Add a zip-package folder, a NuGet-package folder or a NuGet-package server below."
                            TextWrapping="Wrap" TextAlignment="Center"
                            Opacity="0.65" MaxWidth="360"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ListBox Name="SourcesList"
                          AutomationProperties.AutomationId="SourcesList"
                          IsVisible="{Binding !HasNoSources}"
                          ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                          MaxHeight="260">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackageSourceItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,2">
                                <materialIcons:MaterialIcon Grid.Column="0"
                                                              Kind="{Binding TypeIcon}"
                                                              Width="26" Height="26"
                                                              Margin="0,0,10,0"
                                                              VerticalAlignment="Center"
                                                              ToolTip.Tip="{Binding TypeName}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Name="SourceAliasText"
                                                    AutomationProperties.AutomationId="SourceAliasText"
                                                    Text="{Binding Alias}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TypeName}" FontSize="11" Opacity="0.6"
                                                    VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Name="SourceLocationText"
                                                AutomationProperties.AutomationId="SourceLocationText"
                                                Text="{Binding Location}"
                                                ToolTip.Tip="{Binding Location}"
                                                TextTrimming="CharacterEllipsis"
                                                FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                             Margin="10,0,0,0" VerticalAlignment="Center"
                                             ToolTip.Tip="{Binding StatusTooltip}">
                                    <materialIcons:MaterialIcon Kind="{Binding StatusIcon}"
                                                                  Width="16" Height="16"
                                                                  Classes.sourceAvailable="{Binding IsAvailable}"
                                                                  Classes.sourceMissing="{Binding IsMissing}" />
                                    <TextBlock Name="SourceStatusText"
                                                AutomationProperties.AutomationId="SourceStatusText"
                                                Text="{Binding StatusText}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="*,Auto">
            <WrapPanel Grid.Column="0" Orientation="Horizontal">
                <Button Name="AddZipSourceButton"
                         AutomationProperties.AutomationId="AddZipSourceButton"
                         Command="{Binding AddZipSourceCommand}"
                         ToolTip.Tip="Add a folder that contains agent package zip files"
                         Margin="0,0,8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="FolderZip" />
                        <TextBlock Text="Add Zip-Package Folder" />
                    </StackPanel>
                </Button>
                <Button Name="AddNuGetFolderSourceButton"
                         AutomationProperties.AutomationId="AddNuGetFolderSourceButton"
                         Command="{Binding AddNuGetFolderSourceCommand}"
                         ToolTip.Tip="Add a folder that contains NuGet packages (.nupkg files)"
                         Margin="0,0,8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="PackageVariant" />
                        <TextBlock Text="Add NuGet-Package Folder" />
                    </StackPanel>
                </Button>
                <Button Name="AddNuGetServerSourceButton"
                         AutomationProperties.AutomationId="AddNuGetServerSourceButton"
                         Command="{Binding AddNuGetServerSourceCommand}"
                         ToolTip.Tip="Add a NuGet server (for example JFrog Artifactory or Azure Artifacts) that serves agent packages"
                         Margin="0,0,8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="ServerNetwork" />
                        <TextBlock Text="Add NuGet-Package Server" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <Border Height="1" Background="Gray" Opacity="0.4" Margin="0,4,0,0" />

        <TextBlock Text="Tools" FontWeight="Bold" FontSize="15" />

        <TextBlock Text="Git executable path override (blank = use PATH)" FontWeight="SemiBold" />
        <TextBox Name="GitExecutablePathTextBox"
                  AutomationProperties.AutomationId="GitExecutablePathTextBox"
                  PlaceholderText="git"
                  Text="{Binding GitExecutablePath}" />

        <TextBlock Text="Agentic CLI tool" FontWeight="SemiBold" />
        <ComboBox Name="AgentToolComboBox"
                   AutomationProperties.AutomationId="AgentToolComboBox"
                   ItemsSource="{x:Static vm:SettingsWindowViewModel.AvailableAgentTools}"
                   SelectedItem="{Binding AgentTool}"
                   HorizontalAlignment="Stretch">
            <!-- The picker shows friendly names; the selected value (and the saved setting) is the
                 AgentToolKind itself -->
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="settings:AgentToolKind">
                    <TextBlock Text="{Binding Converter={x:Static vm:AgentToolKindDisplayNameConverter.Instance}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox Name="CustomAgentCommandTextBox"
                  AutomationProperties.AutomationId="CustomAgentCommandTextBox"
                  PlaceholderText="Custom command line"
                  IsVisible="{Binding IsCustomAgentToolSelected}"
                  Text="{Binding CustomAgentCommand}" />

        <TextBlock Text="Shell/terminal preference (blank = auto-detect)" FontWeight="SemiBold" />
        <ComboBox Name="ShellPreferenceComboBox"
                   AutomationProperties.AutomationId="ShellPreferenceComboBox"
                   IsEditable="True"
                   PlaceholderText="Auto-detect"
                   ItemsSource="{x:Static vm:SettingsWindowViewModel.AvailableShellPreferences}"
                   Text="{Binding ShellPreference}"
                   HorizontalAlignment="Stretch" />

        <TextBlock Name="SettingsErrorTextBlock"
                    AutomationProperties.AutomationId="SettingsErrorTextBlock"
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    Foreground="Red"
                    TextWrapping="Wrap" />

        <Button Name="SaveSettingsButton"
                 AutomationProperties.AutomationId="SaveSettingsButton"
                 ToolTip.Tip="Save the settings and the package source list"
                 Content="Save"
                 Classes="accent"
                 Command="{Binding SaveCommand}"
                 HorizontalAlignment="Right" />
    </StackPanel>
</Window>
