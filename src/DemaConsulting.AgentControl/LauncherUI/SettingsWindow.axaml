<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DemaConsulting.AgentControl.LauncherUI"
        xmlns:settings="using:DemaConsulting.AgentControl.Settings"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="600" d:DesignHeight="640"
        x:Class="DemaConsulting.AgentControl.LauncherUI.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Name="SettingsWindowRoot"
        Title="Agent Control Settings"
        Width="800" SizeToContent="Height"
        MinWidth="500" MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <!-- Status colors for the sources list: found = green, not found = red (theme-aware
             resources from RepoCardStyles.axaml) -->
        <Style Selector="materialIcons|MaterialIcon.sourceAvailable">
            <Setter Property="Foreground" Value="{DynamicResource StatusAccentUpToDate}" />
        </Style>
        <Style Selector="materialIcons|MaterialIcon.sourceMissing">
            <Setter Property="Foreground" Value="{DynamicResource StatusAccentProblem}" />
        </Style>
    </Window.Styles>
    <!-- The settings scroll when the window is made shorter than its content (the window can be
         resized); the error message and the Save button stay visible below them -->
    <Grid Margin="16" RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" Name="SettingsScrollViewer"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" Margin="0,0,12,0">

        <!-- Package sources: where agent packages come from. Each repo is pinned to one source by
             its alias. Add opens a menu of the source types; Edit and Remove act on the selected
             row, so all three sit on the header line right above the list. -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Package sources" FontWeight="Bold" FontSize="15"
                        VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <!-- One Add button opens a menu of the source types that can be added. To offer
                     another type, add one more MenuItem below:
                     nothing else about the layout changes. Each item shows its type's icon (the
                     same icon the sources list uses) and a one-line description. -->
                <Button Name="AddSourceButton"
                         AutomationProperties.AutomationId="AddSourceButton"
                         Classes="actionButton primary"
                         ToolTip.Tip="Add a package source: a zip-package folder, a NuGet-package folder, a NuGet-package server or a Git repository">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16" />
                        <TextBlock Text="Add" VerticalAlignment="Center" />
                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="16" Height="16" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Name="AddZipSourceButton"
                                       AutomationProperties.AutomationId="AddZipSourceButton"
                                       Command="{Binding AddZipSourceCommand}"
                                       ToolTip.Tip="Add a folder that contains agent package zip files">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="FolderZip" Width="20" Height="20" />
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <StackPanel MinWidth="290" Margin="0,4">
                                        <TextBlock Text="Zip-package folder" FontWeight="SemiBold" />
                                        <TextBlock Text="A folder of agent package .zip files" FontSize="12" Opacity="0.7" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Name="AddNuGetFolderSourceButton"
                                       AutomationProperties.AutomationId="AddNuGetFolderSourceButton"
                                       Command="{Binding AddNuGetFolderSourceCommand}"
                                       ToolTip.Tip="Add a folder that contains NuGet packages (.nupkg files)">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="PackageVariant" Width="20" Height="20" />
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <StackPanel MinWidth="290" Margin="0,4">
                                        <TextBlock Text="NuGet-package folder" FontWeight="SemiBold" />
                                        <TextBlock Text="A folder of NuGet packages (.nupkg files)" FontSize="12" Opacity="0.7" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Name="AddNuGetServerSourceButton"
                                       AutomationProperties.AutomationId="AddNuGetServerSourceButton"
                                       Command="{Binding AddNuGetServerSourceCommand}"
                                       ToolTip.Tip="Add a NuGet server (for example JFrog Artifactory or Azure Artifacts) that serves agent packages">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="ServerNetwork" Width="20" Height="20" />
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <StackPanel MinWidth="290" Margin="0,4">
                                        <TextBlock Text="NuGet-package server" FontWeight="SemiBold" />
                                        <TextBlock Text="A server such as Artifactory or Azure Artifacts" FontSize="12" Opacity="0.7" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Name="AddGitSourceButton"
                                       AutomationProperties.AutomationId="AddGitSourceButton"
                                       Command="{Binding AddGitSourceCommand}"
                                       ToolTip.Tip="Add a Git repository whose tags are agent package versions">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="Git" Width="20" Height="20" />
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <StackPanel MinWidth="290" Margin="0,4">
                                        <TextBlock Text="Git repository" FontWeight="SemiBold" />
                                        <TextBlock Text="Packages are tags of a Git repository" FontSize="12" Opacity="0.7" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Name="EditSourceButton"
                         AutomationProperties.AutomationId="EditSourceButton"
                         Command="{Binding EditSourceCommand}"
                         ToolTip.Tip="Edit the selected source"
                         ToolTip.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="PencilOutline" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button Name="RemoveSourceButton"
                         AutomationProperties.AutomationId="RemoveSourceButton"
                         Command="{Binding RemoveSourceCommand}"
                         ToolTip.Tip="Remove the selected source"
                         ToolTip.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="TrashCanOutline" />
                        <TextBlock Text="Remove" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <TextBlock Text="Agent packages are read from these sources. A repo is pinned to one source by its alias. Use Add to add a source; select a source to edit or remove it."
                    FontSize="11" Opacity="0.65" TextWrapping="Wrap" />

        <Border BorderThickness="1" BorderBrush="{DynamicResource SurfaceBorder}" CornerRadius="4" MinHeight="120">
            <Grid>
                <TextBlock Name="SourcesEmptyText"
                            AutomationProperties.AutomationId="SourcesEmptyText"
                            IsVisible="{Binding HasNoSources}"
                            Text="No package sources yet. Use Add (above) to add a zip-package folder, a NuGet-package folder, a NuGet-package server or a Git repository."
                            TextWrapping="Wrap" TextAlignment="Center"
                            Opacity="0.65" MaxWidth="360"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ListBox Name="SourcesList"
                          AutomationProperties.AutomationId="SourcesList"
                          IsVisible="{Binding !HasNoSources}"
                          ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                          MaxHeight="260">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackageSourceItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,2">
                                <materialIcons:MaterialIcon Grid.Column="0"
                                                              Kind="{Binding TypeIcon}"
                                                              Width="26" Height="26"
                                                              Margin="0,0,10,0"
                                                              VerticalAlignment="Center"
                                                              ToolTip.Tip="{Binding TypeName}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Name="SourceAliasText"
                                                    AutomationProperties.AutomationId="SourceAliasText"
                                                    Text="{Binding Alias}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TypeName}" FontSize="11" Opacity="0.6"
                                                    VerticalAlignment="Center" />
                                        <Border Name="SourceSignedOnlyBadge"
                                                 AutomationProperties.AutomationId="SourceSignedOnlyBadge"
                                                 AutomationProperties.AccessibilityView="Content"
                                                 AutomationProperties.Name="Signed only"
                                                 Classes="Chip"
                                                 Height="18" CornerRadius="9" Padding="6,0"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding RequiresSignature}"
                                                 ToolTip.Tip="{Binding SignatureTooltip}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="ShieldCheck"
                                                                              Width="12" Height="12" />
                                                <TextBlock Text="Signed only" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Name="SourceLocationText"
                                                AutomationProperties.AutomationId="SourceLocationText"
                                                Text="{Binding Location}"
                                                ToolTip.Tip="{Binding Location}"
                                                TextTrimming="CharacterEllipsis"
                                                FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                             Margin="10,0,0,0" VerticalAlignment="Center"
                                             ToolTip.Tip="{Binding StatusTooltip}">
                                    <materialIcons:MaterialIcon Kind="{Binding StatusIcon}"
                                                                  Width="16" Height="16"
                                                                  Classes.sourceAvailable="{Binding IsAvailable}"
                                                                  Classes.sourceMissing="{Binding IsMissing}" />
                                    <TextBlock Name="SourceStatusText"
                                                AutomationProperties.AutomationId="SourceStatusText"
                                                Text="{Binding StatusText}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Height="1" Background="{DynamicResource SurfaceDivider}" Margin="0,4,0,0" />

        <!-- Appearance: how AgentControl looks, apart from the tools it runs below -->
        <TextBlock Name="AppearanceHeadingText"
                    AutomationProperties.AutomationId="AppearanceHeadingText"
                    Text="Appearance" FontWeight="Bold" FontSize="15" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Text="Theme" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                       Name="ThemeComboBox"
                       AutomationProperties.AutomationId="ThemeComboBox"
                       AutomationProperties.Name="Theme"
                       ToolTip.Tip="Choose the color theme: follow the system setting, or always use the light or the dark theme. Applies when you save."
                       ItemsSource="{x:Static vm:SettingsWindowViewModel.AvailableThemes}"
                       SelectedItem="{Binding Theme}"
                       HorizontalAlignment="Stretch">
                <!-- The picker shows friendly names; the selected value (and the saved setting) is the
                     ThemePreference itself -->
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="settings:ThemePreference">
                        <TextBlock Text="{Binding Converter={x:Static vm:ThemePreferenceDisplayNameConverter.Instance}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Border Height="1" Background="{DynamicResource SurfaceDivider}" Margin="0,4,0,0" />

        <!-- Tools: the programs AgentControl runs -->
        <TextBlock Name="ToolsHeadingText"
                    AutomationProperties.AutomationId="ToolsHeadingText"
                    Text="Tools" FontWeight="Bold" FontSize="15" />

        <TextBlock Text="Git executable path override (blank = use PATH)" FontWeight="SemiBold" />
        <TextBox Name="GitExecutablePathTextBox"
                  AutomationProperties.AutomationId="GitExecutablePathTextBox"
                  PlaceholderText="git"
                  Text="{Binding GitExecutablePath}" />

        <TextBlock Text="Agentic CLI tool" FontWeight="SemiBold" />
        <ComboBox Name="AgentToolComboBox"
                   AutomationProperties.AutomationId="AgentToolComboBox"
                   ItemsSource="{x:Static vm:SettingsWindowViewModel.AvailableAgentTools}"
                   SelectedItem="{Binding AgentTool}"
                   HorizontalAlignment="Stretch">
            <!-- The picker shows friendly names; the selected value (and the saved setting) is the
                 AgentToolKind itself -->
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="settings:AgentToolKind">
                    <TextBlock Text="{Binding Converter={x:Static vm:AgentToolKindDisplayNameConverter.Instance}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox Name="CustomAgentCommandTextBox"
                  AutomationProperties.AutomationId="CustomAgentCommandTextBox"
                  PlaceholderText="Custom command line"
                  IsVisible="{Binding IsCustomAgentToolSelected}"
                  Text="{Binding CustomAgentCommand}" />

        <TextBlock Text="Shell/terminal preference (blank = auto-detect)" FontWeight="SemiBold" />
        <ComboBox Name="ShellPreferenceComboBox"
                   AutomationProperties.AutomationId="ShellPreferenceComboBox"
                   IsEditable="True"
                   PlaceholderText="Auto-detect"
                   ItemsSource="{x:Static vm:SettingsWindowViewModel.AvailableShellPreferences}"
                   Text="{Binding ShellPreference}"
                   HorizontalAlignment="Stretch" />

    </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Spacing="12" Margin="0,12,0,0">
        <TextBlock Name="SettingsErrorTextBlock"
                    AutomationProperties.AutomationId="SettingsErrorTextBlock"
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding HasError}"
                    Foreground="{DynamicResource ErrorForeground}"
                    TextWrapping="Wrap" />

        <Button Name="SaveSettingsButton"
                 AutomationProperties.AutomationId="SaveSettingsButton"
                 ToolTip.Tip="Save the settings and the package source list"
                 Content="Save"
                 Classes="accent"
                 Command="{Binding SaveCommand}"
                 HorizontalAlignment="Right" />
    </StackPanel>
    </Grid>
</Window>
