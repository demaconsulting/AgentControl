package AgentControl_RepoCardViewModel {
    private import AgentControl_RepoRefreshQueue::*;
    private import SoftwareItemMetadata::*;

    part def RepoCardViewModel {
        doc /* Per-repo card view-model: pin/git status (the cheap refresh of pin, branch and committed agent folders and the working-tree check run in the background through the shared queue, reading the disk and git off the UI thread and applying only the newest answer; until its state was first read the card shows a Refreshing status and its git-derived facts as not known yet, a card not yet checked shows its Git status as not checked rather than dirty, Refresh and the refresh after a pull are queued ahead of background reads, and Launch, Pull, Upgrade and Select Package wait for the card's pending read and act on what it found), badges, launch (the agent tool is started through an injected process starter and shell detector, with the shell kept open or not according to the keep-shell-open setting in force at the launch)/pull/upgrade/select-package/change-package/favorite/remove actions, the check of the agent files before a launch (a repo with no agent files gets the pinned package silently, files that match the pin's recorded identity launch with no package access, files that differ raise a keep-or-update question that defaults to keeping them, and agent files that were needed but cannot be installed raise a launch-anyway-or-cancel question that defaults to cancel), the signature shield for the source that supplies the package when it requires signed packages, the refuse/confirm/adopt policy for a package version republished with different files (the confirmation is reached through Change package), the portable pin (the pin names no source: the user's own configured sources are asked which offer the pinned package and version, the first whose files have the recorded identity supplies it - whatever its alias or kind - and is named on the package chip, a newer version is still offered when none does, and a pin without a recorded identity is never refused), the Git source presentation (icon and tag, the git-too-old problem, a Refresh that re-reads every source so new versions and tags appear), the setup of Git package sources (user-started work may prompt, background work never), and the confirmation and conversion that takes committed agent folders out of git before a package is applied, and the user-specific group and card color (the tile takes the card's own color, else its group's color, else the automatic color); the disk, hashing and process work of its actions (pin reads and writes, package identities, the .gitignore and release notes of an apply, the AGENTS.md check and answer, the shell detection and process start of a launch) runs off the UI thread through an injected background-work runner, and the "Remove from list" item that says how many selected repos it removes when the card is one of several selected cards. */

        metadata info : SoftwareInfo {
            sourceFiles = ("src/DemaConsulting.AgentControl/LauncherUI/RepoCardViewModel.cs", "src/DemaConsulting.AgentControl/LauncherUI/RepoCardStatus.cs", "src/DemaConsulting.AgentControl/LauncherUI/CardColorPalette.cs", "src/DemaConsulting.AgentControl/LauncherUI/CommittedFilesConversionRequest.cs", "src/DemaConsulting.AgentControl/LauncherUI/AgentFilesChoiceRequest.cs");
            testFiles = ("test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardViewModelTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardServerSourceTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardSignatureTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardImageTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardColorTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardContentIdentityTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardGitSourceTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardGitAwarenessTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardPortablePinTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardCommittedFilesTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardLaunchVerificationTests.cs");
            designFiles = ("docs/design/agent-control/launcher-ui/repo-card-view-model.md");
            verificationFiles = ("docs/verification/agent-control/launcher-ui/repo-card-view-model.md");
            requirementFiles = ("docs/reqstream/agent-control/launcher-ui/repo-card-view-model.yaml");
        }
    }

    // Every lazy read of the card's state (cheap facts, working tree) goes through the shared queue, two at a time across all cards; an action promotes the card's pending reads and awaits them
    dependency RepoCardViewModel to RepoRefreshQueue;
}
