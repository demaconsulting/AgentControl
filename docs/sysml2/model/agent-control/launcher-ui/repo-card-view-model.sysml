package AgentControl {
    private import SoftwareItemMetadata::*;

    part def RepoCardViewModel {
        doc /* Per-repo card view-model: pin/git status, badges, launch/pull/upgrade/select-package/change-package/favorite/remove actions, the signature shield for a pinned source that requires signed packages, the refuse/confirm/adopt policy for a package version republished with different files (the confirmation is reached through Change package), the portable pin (the pinned source alias is a preferred source; another configured source that delivers files with the identical files identity supplies the package, is named on the package chip and is used for the upgrade check, and never without a recorded identity), the Git source presentation (icon, tag and short commit, the "Tag moved" warning that applies nothing, the git-too-old problem), the setup of Git package sources (user-started work may prompt, background work never), and the confirmation and conversion that takes committed agent folders out of git before a package is applied, and the user-specific group and card color. */

        metadata info : SoftwareInfo {
            description = "Per-repo card view-model: pin/git status, badges, launch/pull/upgrade/select-package/change-package/favorite/remove actions, the signature shield for a pinned source that requires signed packages, the refuse/confirm/adopt policy for a package version republished with different files (the confirmation is reached through Change package), the portable pin (the pinned source alias is a preferred source; another configured source that delivers files with the identical files identity supplies the package, is named on the package chip and is used for the upgrade check, and never without a recorded identity), the Git source presentation (icon, tag and short commit, the 'Tag moved' warning that applies nothing, the git-too-old problem), the setup of Git package sources (user-started work may prompt, background work never), the confirmation and conversion that takes committed agent folders out of git before a package is applied, and the user-specific group and card color.";
            sourceFiles = ("src/DemaConsulting.AgentControl/LauncherUI/RepoCardViewModel.cs", "src/DemaConsulting.AgentControl/LauncherUI/RepoCardStatus.cs", "src/DemaConsulting.AgentControl/LauncherUI/CardColorPalette.cs", "src/DemaConsulting.AgentControl/LauncherUI/CommittedFilesConversionRequest.cs");
            testFiles = ("test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardViewModelTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardServerSourceTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardSignatureTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardImageTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardColorTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardContentIdentityTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardGitSourceTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardGitAwarenessTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardPortablePinTests.cs", "test/DemaConsulting.AgentControl.Tests/LauncherUI/RepoCardCommittedFilesTests.cs");
